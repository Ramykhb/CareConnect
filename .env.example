# Copy to .env and supply your local development credentials.
# SQL Server is already running separately on localhost:1433.
RABBITMQ_USER=careconnect
RABBITMQ_PASSWORD=

# Groq AI features: sitter matching and request assistant (both ASP.NET apps).
# Both apps automatically load AI settings from this file in Development.
# Restart after editing. User secrets and process environment variables take precedence.
# Optional explicit shell export before dotnet run:
#   set -a
#   source .env
#   set +a
# Leave empty to use the local ranking only. Never commit your real key.
GROQ_API_KEY=
Ai__Enabled=true
Ai__Model=openai/gpt-oss-20b
Ai__TimeoutSeconds=15
Ai__MaxCandidates=10

# Optional: request chatbot timeout (seconds; sitter matching keeps its own timeout).
Ai__AssistantTimeoutSeconds=30
