# Copy to .env and supply your local development credentials.
# SQL Server is already running separately on localhost:1433.
RABBITMQ_USER=careconnect
RABBITMQ_PASSWORD=

# Groq AI features: sitter matching and request assistant (both ASP.NET apps).
# Both apps automatically load AI settings from this file in Development.
# Restart after editing. User secrets and process environment variables take precedence.
# Optional explicit shell export before dotnet run:
#   set -a
#   source .env
#   set +a
# Leave empty to use the local ranking only. Never commit your real key.
GROQ_API_KEY=
Ai__Enabled=true
Ai__Model=openai/gpt-oss-20b
Ai__TimeoutSeconds=15
Ai__MaxCandidates=10

# Optional: request chatbot and care summary timeout (seconds; sitter matching keeps its own timeout).
Ai__AssistantTimeoutSeconds=30

# Stripe card payments (both ASP.NET apps). Use your sandbox/test keys from
# https://dashboard.stripe.com/test/apikeys. Payments are collected on the platform account;
# sitters do not need Stripe accounts and earnings are tracked in the app.
# Leave empty to keep the local demo payment button. The apps load these from .env in Development;
# restart after editing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret for POST /Stripe/Webhook, from `stripe listen` (whsec_...) or the dashboard endpoint.
# Receives payment_intent.succeeded and account.updated. Leave empty to disable webhooks.
STRIPE_WEBHOOK_SECRET=
