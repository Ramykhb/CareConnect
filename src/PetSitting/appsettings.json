{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=CareConnect_PetSitting;User Id=sa;Encrypt=True;TrustServerCertificate=True"
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "careconnect.events",
    "Queue": "petsitting.events",
    "UseTls": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ai": {
    "Enabled": true,
    "Model": "openai/gpt-oss-20b",
    "TimeoutSeconds": 15,
    "MaxCandidates": 10
  },
  "AllowedHosts": "*",
  "CombinedCare": {
    "PeerOrigin": "http://localhost:5102"
  }
}
