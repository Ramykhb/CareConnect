@using PetSitting.ViewModels
@using PetSitting.Models
@model OwnerBookingDetails
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Receipt @Model.Item.Reference · PawPal</title><style>body{font:15px/1.6 system-ui,sans-serif;color:#191b1c;margin:0;background:#f5f7f4}main{max-width:720px;margin:40px auto;padding:36px;background:white;border-radius:24px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #eaff87;padding-bottom:18px}h1{font-size:28px;margin:0}h2{font-size:16px;margin-top:28px}small,dt{color:#73806f}dl>div{display:flex;gap:20px;margin:12px 0}dt{width:130px;flex-shrink:0}dd{margin:0}table{border-collapse:collapse;width:100%;font-size:13px}th,td{padding:12px;text-align:left;border-bottom:1px solid #e3e8df;overflow-wrap:anywhere}th{background:#f0f3ec}.total{font-size:22px;text-align:right;margin:28px 0}footer{font-size:12px;color:#73806f;border-top:1px solid #e3e8df;padding-top:18px}@@media print{body{background:white}main{margin:0;max-width:none;padding:20px}}@@media(max-width:500px){main{margin:10px;padding:20px}table{font-size:10px}th,td{padding:6px}}</style></head><body><main><header><h1>PawPal</h1><div>Payment receipt<br /><small>#@Model.Item.Reference</small></div></header><dl><div><dt>Care</dt><dd>@Model.Request.Title</dd></div><div><dt>Sitter</dt><dd>@Model.Item.SitterName</dd></div><div><dt>Dates (Beirut)</dt><dd>@DashboardViewModel.Local(Model.Request.StartsAtUtc).ToString("d MMM yyyy h:mm tt") – @DashboardViewModel.Local(Model.Request.EndsAtUtc).ToString("d MMM yyyy h:mm tt")</dd></div></dl><h2>Successful payment records</h2><table><thead><tr><th>Date</th><th>Provider / reference</th><th>Amount</th></tr></thead><tbody>@foreach (var payment in Model.Booking!.Payments.Where(p => p.Status == PaymentStatus.Succeeded && p.Currency == Model.Booking.Currency)) { <tr><td>@DashboardViewModel.Local(payment.PaidAtUtc ?? payment.CreatedAtUtc).ToString("d MMM yyyy")</td><td>@(payment.Provider == "Dummy" ? "Demo payment" : payment.Provider)<br />@payment.ProviderTransactionId</td><td>@DashboardViewModel.Money(payment.Amount, payment.Currency)</td></tr> }</tbody></table><div class="total">Paid @DashboardViewModel.Money(Model.Paid, Model.Item.Currency)</div><footer>@if (Model.Booking.Payments.Any(p => p.Provider == "Dummy")) { <p>This receipt includes demo payment records. No real charge was made for those records.</p> }<p>Booking #@Model.Item.Reference · PawPal by CareConnect</p></footer></main></body></html>
