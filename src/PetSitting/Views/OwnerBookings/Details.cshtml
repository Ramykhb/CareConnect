@using PetSitting.ViewModels
@model OwnerBookingDetails
@{ ViewData["Title"] = Model.Item.Reference; ViewData["Breadcrumb"] = "Requests & Bookings / #" + Model.Item.Reference; }
<div data-ob-detail data-refresh-url="@Url.Action("DetailUpdates", new { id = Model.Request.Id })"><partial name="_DetailBody" model="Model" /></div>
@if (Model.Booking is { } careBooking)
{
    <link rel="stylesheet" href="~/css/care-summary.css" asp-append-version="true" />
    <partial name="/Views/Shared/_CareSummary.cshtml" model="careBooking.Id" />
}
<p><a asp-controller="CombinedCare" asp-action="Index">Manage combined pet and baby care</a></p>

@section Scripts { <script src="~/js/owner-bookings.js" asp-append-version="true"></script><script src="~/js/care-summary.js" asp-append-version="true"></script><script src="~/js/stripe-pay.js" asp-append-version="true"></script> }
