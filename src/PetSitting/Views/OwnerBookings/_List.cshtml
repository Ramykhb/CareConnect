@using PetSitting.ViewModels
@model OwnerBookingsViewModel
<div class="ob-counts" hidden>@foreach (var (key, label) in OwnerBookingsViewModel.Tabs) { <span data-count="@key">@Model.Count(key)</span> }</div>
<div class="ob-table-card">
    @if (Model.Total == 0)
    {
        <div class="ob-empty"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-calendar" /></svg></span><h2>No requests here yet</h2><p>@(Model.Items.Count == 0 && string.IsNullOrWhiteSpace(Model.Search) && Model.PetId is null && Model.Service is null && Model.Days == 0 ? "Your pet’s next adventure starts with a little care." : "Try another status or clear your search and filters.")</p><div><a class="btn btn-light" asp-action="Index">Clear filters</a><a class="btn btn-dark" asp-controller="CareRequests" asp-action="Create">Create a request</a></div></div>
    }
    else
    {
        <div class="ob-table-scroll"><table class="ob-table"><thead><tr><th scope="col">Sitter / pet</th><th scope="col">Service</th><th scope="col">Date</th><th scope="col">Status</th><th scope="col" class="ob-amount">Amount</th></tr></thead><tbody>
            @foreach (var item in Model.Rows)
            {
                var pet = item.Request.Pets.FirstOrDefault()?.Pet;
                <tr><td><a class="ob-row-link" asp-action="Details" asp-route-id="@item.Request.Id"><span class="ob-pet-art species-@(pet?.Species.ToLowerInvariant() ?? "other")"><partial name="/Views/Pets/_PetPortrait.cshtml" model="@(pet?.Species ?? "Other")" /></span><span><strong>@item.SitterName</strong><small>@(string.IsNullOrWhiteSpace(item.PetNames) ? item.Request.Title : item.PetNames) · @(item.Booking is null ? "Request" : "Booking") #@item.Reference</small></span></a></td><td>@OwnerRequestForm.ServiceName(item.Request.ServiceType)</td><td><time datetime="@item.Request.StartsAtUtc.ToString("O")">@DashboardViewModel.Local(item.Request.StartsAtUtc).ToString("d MMM yyyy")</time>@if (DashboardViewModel.Local(item.Request.StartsAtUtc).Date != DashboardViewModel.Local(item.Request.EndsAtUtc).Date) { <small class="ob-end-date">to @DashboardViewModel.Local(item.Request.EndsAtUtc).ToString("d MMM yyyy")</small> }</td><td><span class="ob-status @item.Css"><svg class="line-icon"><use href="@(item.Bucket == "completed" || item.Bucket == "accepted" && item.Status != "Payment pending" ? "#icon-check" : item.Bucket is "cancelled" or "rejected" ? "#icon-close" : "#icon-clock")" /></svg>@item.Status</span></td><td class="ob-amount"><a asp-action="Details" asp-route-id="@item.Request.Id" aria-label="View booking @item.Reference">@DashboardViewModel.Money(item.Amount, item.Currency)<svg class="line-icon"><use href="#icon-chevron" /></svg></a></td></tr>
            }
        </tbody></table></div>
    }
</div>
<footer class="ob-pagination"><span>@(Model.Total == 0 ? "No matching requests" : $"Showing {(Model.CurrentPage - 1) * OwnerBookingsViewModel.PageSize + 1}–{Math.Min(Model.CurrentPage * OwnerBookingsViewModel.PageSize, Model.Total)} of {Model.Total} requests & bookings")</span><nav aria-label="Booking pages">
    @if (Model.CurrentPage > 1) { <a asp-action="Index" asp-route-status="@Model.Filter" asp-route-search="@Model.Search" asp-route-petId="@Model.PetId" asp-route-service="@Model.Service" asp-route-days="@Model.Days" asp-route-page="@(Model.CurrentPage - 1)" aria-label="Previous page"><svg class="line-icon"><use href="#icon-back" /></svg></a> }
    @foreach (var number in Enumerable.Range(1, Model.Pages).Where(p => p == 1 || p == Model.Pages || Math.Abs(p - Model.CurrentPage) <= 1))
    {
        <a class="@(number == Model.CurrentPage ? "active" : "")" aria-current="@(number == Model.CurrentPage ? "page" : null)" asp-action="Index" asp-route-status="@Model.Filter" asp-route-search="@Model.Search" asp-route-petId="@Model.PetId" asp-route-service="@Model.Service" asp-route-days="@Model.Days" asp-route-page="@number">@number</a>
    }
    @if (Model.CurrentPage < Model.Pages) { <a asp-action="Index" asp-route-status="@Model.Filter" asp-route-search="@Model.Search" asp-route-petId="@Model.PetId" asp-route-service="@Model.Service" asp-route-days="@Model.Days" asp-route-page="@(Model.CurrentPage + 1)" aria-label="Next page"><svg class="line-icon"><use href="#icon-arrow" /></svg></a> }
</nav></footer>
