@using PetSitting.Services.Chat
@using PetSitting.ViewModels
@model ChatThread
@{
    ViewData["Title"] = "Chat with " + Model.OtherName;
    ViewData["Breadcrumb"] = "Messages / " + Model.OtherName;
}
<div class="page-header">
    <div class="page-title-row">
        <a class="btn btn-circle" asp-action="Index" aria-label="Back to messages"><svg class="line-icon"><use href="#icon-back" /></svg></a>
        <div><h1>@Model.OtherName</h1><p>@Model.Title · <a href="@Model.BookingUrl">View booking ↗</a></p></div>
    </div>
</div>
<section class="card chat-card" data-chat="@Model.Booking.Id" data-me="@Model.UserId">
    <p class="chat-note"><svg class="line-icon"><use href="#icon-clock" /></svg>Messages are deleted automatically 24 hours after they're read.</p>
    <ol class="chat-messages" data-chat-messages aria-live="polite">
        @foreach (var m in Model.Messages)
        {
            var mine = m.SenderId == Model.UserId;
            <li class="chat-bubble @(mine ? "mine" : "theirs")" data-message="@m.Id">
                <p>@m.Body</p>
                <small><time datetime="@m.CreatedAtUtc.ToString("o")">@DashboardViewModel.Local(m.CreatedAtUtc).ToString("d MMM, HH:mm")</time><span data-expires>@if (m.ExpiresAtUtc is { } expires) { <text> · @(mine ? "Read" : "Seen") · disappears @DashboardViewModel.Local(expires).ToString("d MMM, HH:mm")</text> } else if (mine) { <text> · Sent</text> }</span></small>
            </li>
        }
    </ol>
    <p class="chat-empty" data-chat-empty hidden="@(Model.Messages.Count > 0)">No messages yet. Say hello!</p>
    <form asp-action="Send" asp-route-id="@Model.Booking.Id" method="post" class="chat-form" data-chat-form>
        <label for="chat-body" class="visually-hidden">Message</label>
        <textarea id="chat-body" name="body" maxlength="2000" rows="2" required placeholder="Write a message…"></textarea>
        <button type="submit" class="btn btn-dark"><svg class="line-icon"><use href="#icon-send" /></svg>Send</button>
    </form>
    <p class="chat-status" data-chat-status role="status"></p>
</section>
@section Scripts { <script src="~/js/chat.js" asp-append-version="true"></script> }
