@using PetSitting.ViewModels
@model SitterSettingsViewModel
@{ ViewData["Title"] = "Settings"; ViewData["PortalClass"] = "sitter-portal-page"; }
@section Styles { <link rel="stylesheet" href="~/css/pet-account.css" asp-append-version="true" /> }
<section class="account-page-heading"><div><h1>Settings</h1><p>Your account, sitter profile and preferences, all in one place.</p></div><button type="submit" form="sitter-settings-form" class="btn btn-dark btn-sm"><svg class="line-icon"><use href="#icon-check" /></svg>Save changes</button></section>
<nav class="settings-section-links" aria-label="Settings sections"><a href="#profile-settings" class="active">Profile</a><a href="#services-settings">Services &amp; pricing</a><a href="#security-settings">Security</a><a href="#payout-settings">Payouts</a></nav>
<div class="settings-layout"><form asp-action="SaveSettings" method="post" class="settings-profile-form portal-form" id="sitter-settings-form"><div asp-validation-summary="All" class="settings-validation" role="alert"></div><input asp-for="Form.UserVersion" type="hidden" /><input asp-for="Form.ProfileVersion" type="hidden" />
<section class="dash-card" id="profile-settings"><div class="card-heading"><div><span class="round-icon lime"><svg class="line-icon"><use href="#icon-user" /></svg></span><h2>Personal details</h2></div><span class="status-chip gray">Pet sitter</span></div><div class="settings-person-summary"><span class="portal-avatar">@Model.Account.FirstName.FirstOrDefault()</span><div><strong>@Model.Account.FirstName @Model.Account.LastName</strong><small>@Model.Account.Email</small></div></div><div class="settings-field-grid"><label>First name<input asp-for="Form.FirstName" maxlength="100" required autocomplete="given-name" /><span asp-validation-for="Form.FirstName"></span></label><label>Last name<input asp-for="Form.LastName" maxlength="100" required autocomplete="family-name" /><span asp-validation-for="Form.LastName"></span></label><label>Phone number<input asp-for="Form.Phone" maxlength="30" autocomplete="tel" /><span asp-validation-for="Form.Phone"></span></label><label>Service city<input asp-for="Form.City" maxlength="150" required autocomplete="address-level2" /><span asp-validation-for="Form.City"></span></label></div><p class="portal-muted">Your city helps owners discover your services and determines the requests in your inbox.</p></section>
<section class="dash-card" id="services-settings"><div class="card-heading"><h2>@(Model.Profile is null ? "Set up your sitter profile" : "Sitter profile & services")</h2><span class="status-chip @(Model.Profile?.VerificationStatus == VerificationStatus.Verified ? "green" : "gray")">@(Model.Profile?.VerificationStatus == VerificationStatus.Verified ? "Verified" : "Verification: " + (Model.Profile?.VerificationStatus.ToString() ?? "Not submitted"))</span></div><label>About your care<textarea asp-for="Form.Bio" maxlength="2000" rows="5" required placeholder="Tell owners about your experience and the care you offer…"></textarea><span asp-validation-for="Form.Bio"></span></label><div class="settings-field-grid"><label>Years of experience<input asp-for="Form.Experience" type="number" min="0" max="80" required /></label><label>Hourly rate<input asp-for="Form.HourlyRate" type="number" min="0" max="99999999" step="0.01" required /></label><label>Rate currency<input asp-for="Form.Currency" maxlength="3" pattern="[A-Z]{3}" placeholder="USD" required /><small>Three-letter code, e.g. USD, EUR or LBP.</small></label></div><fieldset class="settings-services"><legend>Services you offer</legend>@foreach (var service in Enum.GetValues<ServiceType>()) { <label><input type="checkbox" name="Form.Services" value="@service" checked="@Model.Form.Services.Contains(service)" /><span>@DashboardViewModel.Service(service)</span></label> }<span asp-validation-for="Form.Services"></span></fieldset><label class="settings-availability"><div><strong>Accepting new requests</strong><small>Existing bookings stay in place when you pause new requests.</small></div><input class="alert-switch" asp-for="Form.Available" type="checkbox" /></label><a asp-controller="SitterAvailability" asp-action="Index" class="settings-calendar-link">Manage available dates and hours ↗</a><div class="settings-save-row"><span class="portal-muted">Verification status is managed separately from your public profile.</span><button type="submit" class="btn btn-dark btn-sm">Save profile</button></div></section></form>
<aside class="settings-side-column"><section class="dash-card security-settings" id="security-settings"><div class="card-heading"><span class="round-icon"><svg class="line-icon"><use href="#icon-shield" /></svg></span><h2>Account &amp; security</h2></div><a asp-area="Identity" asp-page="/Account/Manage/ChangePassword"><span>Change password<small>Keep your sign-in details secure.</small></span><svg class="line-icon"><use href="#icon-diagonal" /></svg></a><a asp-area="Identity" asp-page="/Account/Manage/Email"><span>Email address<small>@Model.Account.Email</small></span><svg class="line-icon"><use href="#icon-diagonal" /></svg></a><a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication"><span>Two-factor authentication<small>Add another step to protect your account.</small></span><svg class="line-icon"><use href="#icon-diagonal" /></svg></a><a asp-area="Identity" asp-page="/Account/Manage/PersonalData"><span>Personal data<small>Download your data or manage account closure.</small></span><svg class="line-icon"><use href="#icon-diagonal" /></svg></a></section>
<partial name="_Alerts" model="@((Model.Alerts, true))" />
<section class="dash-card payout-settings-card" id="payout-settings"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-wallet" /></svg></span><h2>Payout settings</h2><p>Your booking payments keep their recorded currency. Payout requests reserve eligible funds from completed bookings.</p><p>Bank transfers are not connected yet. No bank account details are collected here.</p><a asp-action="Earnings" class="btn btn-dark btn-sm full-width">View earnings &amp; requests ↗</a></section></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/pet-account.js" asp-append-version="true"></script> }
