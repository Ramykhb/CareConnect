@using PetSitting.ViewModels
@model OwnerSettingsViewModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Account settings";
    ViewData["Breadcrumb"] = "Settings";
    ViewData["PortalClass"] = "owner-settings-page";
}
<header class="os-heading"><h1>Account settings</h1><p>Manage your profile, security and preferences.</p></header>
<div class="os-layout"><nav class="os-navigation" aria-label="Settings sections"><a class="active" href="#personal-settings"><svg class="line-icon"><use href="#icon-user" /></svg>Personal information</a><a href="#security-settings"><svg class="line-icon"><use href="#icon-lock" /></svg>Security</a><a href="#notification-settings"><svg class="line-icon"><use href="#icon-bell" /></svg>Notifications</a><a href="#payment-settings"><svg class="line-icon"><use href="#icon-card" /></svg>Payment methods</a><a href="#privacy-settings"><svg class="line-icon"><use href="#icon-shield" /></svg>Privacy</a><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post"><button type="submit"><svg class="line-icon"><use href="#icon-logout" /></svg>Log out</button></form></nav>
<div class="os-panels">
    <section class="os-card" id="personal-settings" aria-labelledby="personal-heading">
        <div class="os-person"><span class="os-avatar">@if (Model.Account.ProfilePhotoVersion is { } photoVersion) { <img src="@Url.Action("Photo", new { v = photoVersion })" alt="Your profile photo" /> } else { <svg viewBox="0 0 80 80" fill="none" aria-hidden="true"><circle cx="40" cy="40" r="40" fill="#DDE8DF"/><path d="M20 77c1-19 11-28 20-28s20 9 21 28" fill="#263E35"/><path d="M25 32c0-13 7-19 16-19 13 0 17 11 16 23l-1 17H25V32Z" fill="#4B3228"/><ellipse cx="41" cy="35" rx="13" ry="16" fill="#DFA984"/><path d="M28 29c0-13 22-15 27 0-9-1-13-5-15-7-3 4-8 6-12 7Z" fill="#4B3228"/><circle cx="36" cy="35" r="1.5" fill="#302C2A"/><circle cx="46" cy="35" r="1.5" fill="#302C2A"/><path d="M37 42q4 3 8 0" stroke="#7F4F3A" stroke-width="2" stroke-linecap="round"/></svg> }</span><div><h2 id="personal-heading">@Model.Account.FirstName @Model.Account.LastName</h2><p>Pet owner since @Model.Account.CreatedAtUtc.ToString("MMMM yyyy")</p></div><details class="os-photo-picker"><summary class="btn btn-light"><svg class="line-icon"><use href="#icon-upload" /></svg>Change photo</summary><form asp-action="UploadPhoto" method="post" enctype="multipart/form-data"><label for="profile-photo">Profile photo</label><input type="file" name="photo" id="profile-photo" accept="image/jpeg,image/png,image/webp" required /><small>JPEG, PNG or WebP · up to 2 MB</small><button type="submit" class="btn btn-dark">Upload photo</button></form></details></div>
        <form asp-action="Profile" method="post" id="owner-profile-form" novalidate>@if (ViewData["SettingsSection"] as string != "security-settings") { <div asp-validation-summary="ModelOnly" class="os-errors" role="alert"></div> }<input asp-for="Profile.Version" type="hidden" /><div class="os-field-grid">
            <div class="os-field"><label asp-for="Profile.FirstName"></label><input asp-for="Profile.FirstName" maxlength="100" autocomplete="given-name" /><span asp-validation-for="Profile.FirstName"></span></div><div class="os-field"><label asp-for="Profile.LastName"></label><input asp-for="Profile.LastName" maxlength="100" autocomplete="family-name" /><span asp-validation-for="Profile.LastName"></span></div>
            <div class="os-field"><label for="owner-email">Email address</label><div class="os-icon-input @(Model.Account.EmailConfirmed ? "verified" : "")"><svg class="line-icon"><use href="#icon-mail" /></svg><input id="owner-email" type="email" value="@Model.Account.Email" readonly aria-describedby="email-status" />@if (Model.Account.EmailConfirmed) { <svg class="line-icon os-verified" aria-label="Verified"><use href="#icon-check" /></svg> }</div><small id="email-status">@(Model.Account.EmailConfirmed ? "Verified email" : "Email verification needed") · <a asp-area="Identity" asp-page="/Account/Manage/Email">Change email ↗</a></small></div>
            <div class="os-field"><label asp-for="Profile.Phone">Phone</label><div class="os-icon-input"><svg class="line-icon"><use href="#icon-phone" /></svg><input asp-for="Profile.Phone" type="tel" maxlength="30" autocomplete="tel" placeholder="e.g. +961 71 234 567" /></div><span asp-validation-for="Profile.Phone"></span></div>
            <div class="os-field"><label asp-for="Profile.HomeAddress"></label><div class="os-icon-input"><svg class="line-icon"><use href="#icon-pin" /></svg><input asp-for="Profile.HomeAddress" maxlength="300" autocomplete="street-address" placeholder="Street, building and area" /></div><span asp-validation-for="Profile.HomeAddress"></span></div><div class="os-field"><label asp-for="Profile.City"></label><input asp-for="Profile.City" maxlength="150" autocomplete="address-level2" placeholder="e.g. Beirut" /><span asp-validation-for="Profile.City"></span></div>
            <div class="os-field"><label asp-for="Profile.Language"></label><select asp-for="Profile.Language"><option value="en">English</option><option value="ar">العربية · Arabic</option><option value="fr">Français · French</option></select><span asp-validation-for="Profile.Language"></span><small>Saved with your profile. The interface is currently in English.</small></div><div class="os-field"><label asp-for="Profile.EmergencyContact"></label><div class="os-icon-input"><svg class="line-icon"><use href="#icon-phone" /></svg><input asp-for="Profile.EmergencyContact" maxlength="200" placeholder="Contact name and phone number" /></div><span asp-validation-for="Profile.EmergencyContact"></span></div>
        </div><div class="os-form-actions"><a class="btn btn-ghost" asp-action="Index">Discard</a><button class="btn btn-dark" type="submit"><svg class="line-icon"><use href="#icon-check" /></svg>Save changes</button></div></form>
    </section>
    <section class="os-card" id="security-settings" aria-labelledby="security-heading"><h2 id="security-heading">Security</h2>
        @if (Model.HasPassword)
        {
            <form asp-action="Password" method="post" class="os-password-form" novalidate>@if (ViewData["SettingsSection"] as string == "security-settings") { <div asp-validation-summary="ModelOnly" class="os-errors" role="alert"></div> }<div class="os-field-grid"><div class="os-field"><label asp-for="PasswordChange.CurrentPassword"></label><div class="os-icon-input"><svg class="line-icon"><use href="#icon-lock" /></svg><input asp-for="PasswordChange.CurrentPassword" autocomplete="current-password" /></div><span asp-validation-for="PasswordChange.CurrentPassword"></span></div><div class="os-field"><label asp-for="PasswordChange.NewPassword"></label><div class="os-icon-input"><svg class="line-icon"><use href="#icon-lock" /></svg><input asp-for="PasswordChange.NewPassword" autocomplete="new-password" /></div><span asp-validation-for="PasswordChange.NewPassword"></span></div><div class="os-field"><label asp-for="PasswordChange.ConfirmPassword"></label><input asp-for="PasswordChange.ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="PasswordChange.ConfirmPassword"></span></div><p class="os-password-help">Use 12+ characters, with uppercase and lowercase letters, a number and a symbol.</p></div><div class="os-form-actions"><button type="submit" class="btn btn-light">Update password<svg class="line-icon"><use href="#icon-arrow" /></svg></button></div></form>
        }
        else { <a class="btn btn-light" asp-area="Identity" asp-page="/Account/Manage/SetPassword">Set a password</a> }
        <a class="os-two-factor" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-shield" /></svg></span><span><strong>Two-factor authentication</strong><small>@(Model.TwoFactorEnabled ? "Enabled · manage your authenticator and recovery codes" : "Add a verification code from an authenticator app at login")</small></span><span class="os-toggle @(Model.TwoFactorEnabled ? "on" : "")" aria-hidden="true"></span><span class="os-sr-only">@(Model.TwoFactorEnabled ? "Enabled. Manage two-factor authentication" : "Set up two-factor authentication")</span></a>
        <h3 class="os-session-heading">Active sessions</h3><div class="os-session"><span class="round-icon"><svg class="line-icon"><use href="#icon-bolt" /></svg></span><div><strong>This browser</strong><small>Current session@(Model.SignedInAt is { } signedIn ? " · signed in " + DashboardViewModel.Local(signedIn).ToString("d MMM, h:mm tt") : "")</small></div><span class="os-session-status"><svg class="line-icon"><use href="#icon-check" /></svg>Active</span></div>
        @if (Model.HasPassword) { <details class="os-revoke-sessions"><summary>Sign out other sessions <svg class="line-icon"><use href="#icon-diagonal" /></svg></summary><p>This browser stays signed in. Other browsers and devices will need to log in again.</p><form asp-action="Sessions" method="post"><div class="os-field"><label for="sessions-password">Confirm your current password</label><input type="password" id="sessions-password" name="currentPassword" autocomplete="current-password" required /></div><button type="submit" class="btn btn-light">Sign out other sessions</button></form></details> }
        <div class="os-delete-account"><div><strong>Delete account</strong><small>Account deletion requires your password. Saved care records may require a platform manager’s assistance.</small></div><a class="btn btn-danger" asp-area="Identity" asp-page="/Account/Manage/DeletePersonalData">Delete</a></div>
    </section>
    <section class="os-card" id="notification-settings" aria-labelledby="notification-heading"><h2 id="notification-heading">Notifications</h2><p class="os-section-intro">Choose which updates appear on your dashboard. Your care activity remains recorded.</p><form asp-action="Alerts" method="post"><input asp-for="Alerts.Version" type="hidden" /><label class="os-preference"><span><strong>Requests &amp; responses</strong><small>When a sitter responds to your request.</small></span><input class="os-switch" asp-for="Alerts.Requests" /></label><label class="os-preference"><span><strong>Booking updates</strong><small>Check-ins, completion and care updates.</small></span><input class="os-switch" asp-for="Alerts.Bookings" /></label><label class="os-preference"><span><strong>Payments</strong><small>Payment confirmations and status changes.</small></span><input class="os-switch" asp-for="Alerts.Payments" /></label><label class="os-preference"><span><strong>Reviews</strong><small>Activity related to your care reviews.</small></span><input class="os-switch" asp-for="Alerts.Reviews" /></label><div class="os-form-actions"><button type="submit" class="btn btn-dark"><svg class="line-icon"><use href="#icon-check" /></svg>Save preferences</button></div></form></section>
    <section class="os-card" id="payment-settings" aria-labelledby="payment-heading"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-card" /></svg></span><h2 id="payment-heading">Payment methods</h2><p class="os-section-intro">Payments are recorded per booking in this demo. No card or bank details are collected or stored.</p><a class="btn btn-light" asp-controller="OwnerBookings" asp-action="Index" asp-route-status="accepted">View bookings &amp; payments<svg class="line-icon"><use href="#icon-arrow" /></svg></a></section>
    <section class="os-card" id="privacy-settings" aria-labelledby="privacy-heading"><h2 id="privacy-heading">Privacy</h2><p class="os-section-intro">Your exact address is shared only with the sitter who accepts your request. Keep account and contact details up to date.</p><a class="os-privacy-link" asp-area="Identity" asp-page="/Account/Manage/PersonalData"><span><strong>Your personal data</strong><small>Download your account data or manage account deletion.</small></span><svg class="line-icon"><use href="#icon-diagonal" /></svg></a></section>
</div></div>
@section Styles { <link rel="stylesheet" href="~/css/owner-settings.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/owner-settings.js" asp-append-version="true"></script> }
