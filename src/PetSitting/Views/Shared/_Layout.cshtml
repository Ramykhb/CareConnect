<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · CareConnect</title><link rel="stylesheet" href="~/css/pet-auth.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/identity.css" asp-append-version="true" />@await RenderSectionAsync("Styles", required: false)</head>
<body class="careconnect-public"><a class="auth-skip" href="#main-content">Skip to content</a><partial name="_PetIcons" />
<div class="public-shell"><header class="public-topbar"><a class="auth-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-icon"><svg><use href="#icon-paw" /></svg></span>CareConnect</a><nav aria-label="Main navigation">@if (!User.IsInRole(Roles.PlatformManager)) { <a asp-area="" asp-controller="Home" asp-action="Index">Home</a><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> }<partial name="_LoginPartial" /></nav></header>
<main id="main-content" class="public-card identity-content">@RenderBody()</main><footer class="public-footer">CareConnect · Thoughtful care, every step.</footer></div>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/js/identity.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)<partial name="/Views/Shared/_RequestAssistant.cshtml" />
</body></html>
