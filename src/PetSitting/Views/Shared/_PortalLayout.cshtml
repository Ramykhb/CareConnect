@using Microsoft.AspNetCore.Identity
@using PetSitting.ViewModels
@inject UserManager<ApplicationUser> UserManager
@{
    var portal = Model as IPortalViewModel;
    var user = portal?.Account ?? await UserManager.GetUserAsync(User);
    var sitter = User.IsInRole(Roles.Sitter);
    var displayName = user is null ? "Your account" : $"{user.FirstName} {user.LastName}";
    var initial = string.IsNullOrEmpty(user?.FirstName) ? "?" : user.FirstName[..1].ToUpperInvariant();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var portalRoutes = new Dictionary<string, string> { ["earnings"] = "Earnings", ["reports"] = "Analytics", ["reviews"] = "Reviews", ["notifications"] = "Notifications" };
    var home = Url.Action(sitter ? "Sitter" : "Customer", "Dashboard");
    var unread = portal?.Unread ?? 0;
    var menu = sitter
        ? new[] { ("overview", "Dashboard", "grid"), ("requests", "Requests", "inbox"), ("bookings", "Bookings", "calendar"), ("availability", "Availability", "clock"), ("earnings", "Earnings", "wallet"), ("reports", "Analytics", "chart"), ("reviews", "Reviews", "star"), ("notifications", "Notifications", "bell") }
        : new[] { ("overview", "Dashboard", "grid"), ("pets", "My Pets", "paw"), ("sitters", "Find Sitters", "search"), ("bookings", "Bookings", "calendar"), ("messages", "Messages", "chat"), ("payments", "Payments", "card"), ("reviews", "Reviews", "star"), ("notifications", "Notifications", "bell") };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7f3" />
    <title>@ViewData["Title"] · CareConnect</title>
    <link rel="stylesheet" href="~/css/pet-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pet-portal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pet-dashboard.css" asp-append-version="true" />
    @if (controller == "Pets")
    {
        <link rel="stylesheet" href="~/css/pet-profiles.css" asp-append-version="true" />
    }
    @if (controller == "CareRequests")
    {
        <link rel="stylesheet" href="~/css/owner-requests.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="pet-portal @(portal is null ? "" : "dashboard-page") @ViewData["PortalClass"]">
    <a class="auth-skip" href="#main-content">Skip to content</a>
    <partial name="_PortalIcons" />
    <div class="portal-shell">
        <aside class="portal-sidebar" id="portal-navigation" aria-label="@(sitter ? "Sitter" : "Owner") navigation">
            <div>
                <a class="portal-brand" asp-controller="Home" asp-action="Index" aria-label="PawPal · CareConnect home"><span class="brand-icon"><svg><use href="#icon-paw" /></svg></span>PawPal</a>
                <p class="portal-menu-label">@(sitter ? "Workspace" : "Menu")</p>
                <nav class="portal-nav">
                    @foreach (var (key, label, icon) in menu)
                    {
                        var active = controller == "Dashboard" && key == "overview" || controller == "Pets" && key == "pets" || controller == "CareRequests" && key == "bookings" || controller == "SitterRequests" && key == "requests" || controller == "SitterBookings" && key == "bookings" || controller == "SitterAvailability" && key == "availability" || controller == "SitterPortal" && portalRoutes.GetValueOrDefault(key) == action;
                        var href = key == "pets" ? Url.Action("Index", "Pets") : sitter && key == "requests" ? Url.Action("Index", "SitterRequests") : sitter && key == "bookings" ? Url.Action("Index", "SitterBookings") : sitter && key == "availability" ? Url.Action("Index", "SitterAvailability") : sitter && portalRoutes.ContainsKey(key) ? Url.Action(portalRoutes[key], "SitterPortal") : home + "#" + key;
                        <a class="@(active ? "active" : "")" href="@href" data-nav-section="@key"><svg class="line-icon @(icon == "paw" ? "paw-icon" : "")"><use href="#icon-@icon" /></svg><span>@label</span>
                            @if (key == "requests" && portal?.IncomingRequestCount > 0) { <span class="nav-count">@portal.IncomingRequestCount</span> }
                            @if (key == "notifications" && unread > 0) { <span class="nav-count">@unread</span> }
                        </a>
                    }
                    <a href="@(sitter ? Url.Action("Settings", "SitterPortal") : Url.Page("/Account/Manage/Index", new { area = "Identity" }))" class="@(controller == "SitterPortal" && action == "Settings" ? "active" : "")"><svg class="line-icon"><use href="#icon-settings" /></svg><span>Settings</span></a>
                </nav>
            </div>
            <div class="sidebar-bottom">
                @if (sitter)
                {
                    <a href="@Url.Action("Index", "SitterAvailability")" class="availability-promo"><span>Accepting requests <span class="mini-switch @(portal?.Profile?.IsAvailable == true ? "on" : "")" aria-hidden="true"></span></span><small>@(portal?.Profile is null ? "Set up your sitter profile to get started." : $"Your availability in {portal.Profile.City}.")</small></a>
                }
                else
                {
                    <a class="sidebar-promo" href="@(home)#sitters"><span class="round-icon"><svg class="line-icon"><use href="#icon-sparkles" /></svg></span><strong>A little help. A lot of care.</strong><small>Find a friendly sitter for your pet’s next stay.</small><span>Explore sitters ↗</span></a>
                }
                <div class="portal-user">
                    <a class="portal-avatar" asp-area="Identity" asp-page="/Account/Manage/Index" aria-label="Manage account">@initial</a>
                    <span class="portal-user-text"><strong>@displayName</strong><small>@(sitter ? "Pet sitter" : "Pet owner")@(string.IsNullOrEmpty(user?.City) ? "" : " · " + user.City)</small></span>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="portal-icon-button" aria-label="Log out"><svg class="line-icon"><use href="#icon-logout" /></svg></button>
                    </form>
                </div>
            </div>
        </aside>
        <div class="portal-main">
            <header class="portal-topbar">
                <button class="mobile-nav-toggle round-icon" type="button" aria-label="Toggle navigation" aria-controls="portal-navigation" aria-expanded="false"><svg class="line-icon"><use href="#icon-menu" /></svg></button>
                <nav class="portal-breadcrumb" aria-label="Breadcrumb"><span>@(sitter ? "Sitter" : "Owner") portal</span><span aria-hidden="true">›</span><span>@(ViewData["Breadcrumb"] ?? ViewData["Title"])</span></nav>
                <div class="topbar-tools">
                    @if (controller == "Pets")
                    {
                        <form class="dashboard-search pets-top-search" asp-controller="Pets" asp-action="Index" method="get" role="search">
                            <svg class="line-icon"><use href="#icon-search" /></svg><input type="search" name="search" value="@ViewBag.Search" placeholder="Search your pets…" aria-label="Search pets by name or breed" /><button type="submit" aria-label="Search pets"><svg class="line-icon"><use href="#icon-arrow" /></svg></button>
                        </form>
                    }
                    else if (portal is not null)
                    {
                        <label class="dashboard-search"><svg class="line-icon"><use href="#icon-search" /></svg><input id="dashboard-search" type="search" form="@ViewData["SearchForm"]" name="search" value="@ViewData["SearchTerm"]" placeholder="@(sitter ? "Search requests, pets…" : "Search pets, bookings…")" aria-label="Search dashboard" /><kbd>Ctrl K</kbd></label>
                    }
                    <a href="@(sitter ? Url.Action("Notifications", "SitterPortal") : home + "#notifications")" class="round-icon notification-shortcut" aria-label="Notifications, @unread unread"><svg class="line-icon"><use href="#icon-bell" /></svg>@if (unread > 0) { <i></i> }</a>
                    <button type="button" class="round-icon topbar-message" data-feature="Messages" aria-label="Messages"><svg class="line-icon"><use href="#icon-chat" /></svg></button>
                    <details class="account-menu"><summary><span class="portal-avatar">@initial</span><span><strong>@displayName</strong><small>@(sitter ? "Pet sitter" : "Pet owner")</small></span><svg class="line-icon"><use href="#icon-down" /></svg></summary><div><a href="@(sitter ? Url.Action("Settings", "SitterPortal") : Url.Page("/Account/Manage/Index", new { area = "Identity" }))">Manage your account ↗</a><form asp-area="Identity" asp-page="/Account/Logout" method="post"><button type="submit">Log out</button></form></div></details>
                </div>
            </header>
            <main id="main-content">
                @if (TempData["Success"] is string success) { <div class="portal-notice success" role="status">@success</div> }
                @if (TempData["Error"] is string error) { <div class="portal-notice error" role="alert">@error</div> }
                @RenderBody()
            </main>
            <footer class="portal-footer"><span>A little care makes a big difference.</span><span>PawPal by CareConnect <svg class="line-icon paw-icon"><use href="#icon-paw" /></svg></span></footer>
        </div>
    </div>
    <dialog id="feature-dialog" class="dashboard-dialog" aria-labelledby="feature-title"><button type="button" class="dialog-close round-icon" data-close aria-label="Close"><svg class="line-icon"><use href="#icon-close" /></svg></button><span class="round-icon lime"><svg class="line-icon"><use href="#icon-paw" /></svg></span><h2 id="feature-title">More care is on the way</h2><p id="feature-description">This feature is being prepared. You can manage your pets and account today.</p><button class="btn btn-dark" type="button" data-close>Got it</button></dialog>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/pet-dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
