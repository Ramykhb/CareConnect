<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7f3" />
    <title>@ViewData["Title"] · CareConnect Pet Sitting</title>
    <link rel="stylesheet" href="~/css/pet-auth.css" asp-append-version="true" />
</head>
<body class="pet-auth">
    <a class="auth-skip" href="#auth-main">Skip to form</a>
    <svg class="auth-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="icon-paw" viewBox="0 0 24 24"><ellipse cx="6.4" cy="8.1" rx="2.2" ry="2.8" transform="rotate(-25 6.4 8.1)"/><ellipse cx="10.5" cy="4.8" rx="2" ry="2.5"/><ellipse cx="15.1" cy="5.1" rx="2" ry="2.5" transform="rotate(15 15.1 5.1)"/><ellipse cx="18.6" cy="9" rx="2" ry="2.6" transform="rotate(30 18.6 9)"/><path d="M6.8 15.2c0-2.4 2.6-5.1 5.1-5.1s5.5 3.2 5.5 5.7c0 2.2-1.5 3.2-3.2 2.8-1.6-.4-2.2-.7-3.6-.2-2.4.9-3.8-.8-3.8-3.2Z"/></symbol>
        <symbol id="icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></symbol>
        <symbol id="icon-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></symbol>
        <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
        <symbol id="icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
        <symbol id="icon-shield" viewBox="0 0 24 24"><path d="m12 3 7 3v5c0 4-3 7-7 10-4-3-7-6-7-10V6l7-3Z"/><path d="m8.5 11 2.5 2.5 4.5-4.5"/></symbol>
    </svg>
    <div class="auth-shell">
        <aside class="auth-story" aria-label="CareConnect pet sitting">
            <div class="story-top"><a class="auth-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-icon"><svg><use href="#icon-paw" /></svg></span>CareConnect</a><span class="portal-badge"><svg><use href="#icon-paw" /></svg>Pet care portal</span></div>
            <h2>Care your pets <br />deserve, while you’re <br />away.</h2>
            <div class="story-review"><div class="review-stars" aria-label="5 out of 5 stars">★★★★★</div><p>“I knew Max was safe the whole weekend.<br />Updates came in instantly.”</p><div class="review-person"><span class="review-avatar" aria-hidden="true">S</span><span>Sarah H. · Owner of Max</span></div></div>
            <img class="story-pets" src="~/images/auth-pets.svg" alt="A friendly golden dog and grey cat nestled in a bright lime circle" width="490" height="470" />
        </aside>
        <main id="auth-main" class="auth-main">@RenderBody()</main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/pet-auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
