@using PetSitting.ViewModels
@model IReadOnlyList<Notification>
@{
    ViewData["Title"] = "Notifications";
    var filter = (string)ViewBag.Filter;
    var unread = (int)ViewBag.Unread;
}
<div class="page-header">
    <div>
        <h1>Notifications</h1>
        <p>Updates about your requests, bookings and payments arrive here instantly.</p>
    </div>
    @if (unread > 0)
    {
        <form asp-action="ReadAll" asp-route-filter="@filter" method="post" class="header-actions"><button type="submit" class="btn btn-ghost"><svg class="line-icon"><use href="#icon-check" /></svg>Mark all as read</button></form>
    }
</div>
<nav class="request-filters" aria-label="Filter notifications">
    <a class="filter-pill @(filter == "all" ? "active" : "")" asp-action="Index">All</a>
    <a class="filter-pill @(filter == "unread" ? "active" : "")" asp-action="Index" asp-route-filter="unread">Unread <span data-live-unread-count>@unread</span></a>
</nav>
<div class="request-list" data-live-feed>
    @if (Model.Count == 0)
    {
        <section class="empty-state" data-live-empty>
            <span class="add-circle"><svg class="line-icon" width="40" height="40"><use href="#icon-bell" /></svg></span>
            <h2>@(filter == "unread" ? "No unread notifications" : "You're all caught up")</h2>
            <p>When a sitter accepts, cancels or updates a booking, you'll see it here right away.</p>
        </section>
    }
    @foreach (var n in Model)
    {
        <article data-notification-category="@n.Category.ToString().ToLowerInvariant()" class="card request-row notification-row @(n.ReadAtUtc is null ? "unread" : "")">
            <div><strong>@n.Title</strong><span class="pet-meta">@n.Body</span><span class="pet-meta">@DashboardViewModel.Local(n.CreatedAtUtc).ToString("ddd d MMM, HH:mm")</span></div>
            <div class="request-row-side notification-actions">
                @if (n.ReadAtUtc is null) { <span class="status-chip yellow">New</span> }
                @if (n.RelativeUrl is not null) { <form asp-action="Open" asp-route-id="@n.Id" method="post"><button type="submit" class="btn btn-dark btn-sm">Open</button></form> }
                <form asp-action="Read" asp-route-id="@n.Id" asp-route-read="@(n.ReadAtUtc is null ? "true" : "false")" asp-route-filter="@filter" method="post"><button type="submit" class="btn btn-light btn-sm">@(n.ReadAtUtc is null ? "Mark read" : "Mark unread")</button></form>
                <form asp-action="Dismiss" asp-route-id="@n.Id" asp-route-filter="@filter" method="post"><button type="submit" class="btn btn-ghost btn-sm" aria-label="Dismiss notification"><svg class="line-icon"><use href="#icon-close" /></svg></button></form>
            </div>
        </article>
    }
</div>
