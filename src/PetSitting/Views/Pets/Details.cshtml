@model Pet
@{
    ViewData["Title"] = Model.Name;
    ViewData["Breadcrumb"] = "My pets / " + Model.Name;
}

<div class="page-header">
    <div class="page-title-row">
        <a class="btn btn-circle" asp-action="Index" aria-label="Back to my pets"><svg class="line-icon"><use href="#icon-back" /></svg></a>
        <h1>@Model.Name’s profile</h1>
    </div>
    <div class="header-actions">
        <a class="btn btn-ghost" asp-action="Delete" asp-route-id="@Model.Id"><svg class="line-icon"><use href="#icon-trash" /></svg>Delete</a>
        <a class="btn btn-dark" asp-action="Edit" asp-route-id="@Model.Id"><svg class="line-icon"><use href="#icon-edit" /></svg>Edit profile</a>
    </div>
</div>

<div class="details-layout">
    <section class="card profile-card" aria-label="Pet summary">
        <div class="pet-photo species-@Model.Species.ToLowerInvariant()">
            <span class="pet-initial" aria-hidden="true">@Model.Name[..1].ToUpperInvariant()</span>
        </div>
        <div>
            <h2>@Model.Name</h2>
            <span class="pet-meta">@Model.Species@(string.IsNullOrEmpty(Model.Breed) ? "" : " · " + Model.Breed)</span>
        </div>
        <div class="facts">
            <div class="fact"><small>Species</small><strong>@Model.Species</strong></div>
            <div class="fact"><small>Breed</small><strong>@(Model.Breed ?? "—")</strong></div>
            <div class="fact"><small>Age</small><strong>@(Model.AgeYears is int age ? $"{age} {(age == 1 ? "year" : "years")}" : "—")</strong></div>
            <div class="fact"><small>Added</small><strong>@Model.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</strong></div>
        </div>
    </section>

    <section class="card" aria-label="Care details">
        <div class="info-section">
            <h3>Medical notes</h3>
            @if (string.IsNullOrWhiteSpace(Model.MedicalNotes)) { <p class="muted">No medical notes yet.</p> } else { <p>@Model.MedicalNotes</p> }
        </div>
        <div class="info-section">
            <h3>Feeding instructions</h3>
            @if (string.IsNullOrWhiteSpace(Model.FeedingInstructions)) { <p class="muted">No feeding instructions yet.</p> } else { <p>@Model.FeedingInstructions</p> }
        </div>
        <div class="info-section">
            <h3>Special requirements</h3>
            @if (string.IsNullOrWhiteSpace(Model.CareInstructions)) { <p class="muted">No special requirements yet.</p> } else { <p>@Model.CareInstructions</p> }
        </div>
    </section>
</div>
