@using PetSitting.ViewModels
@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; Layout = "_PortalLayout"; var pendingBooking = Model.Upcoming.FirstOrDefault(b => !PetSitting.Services.Bookings.BookingRules.FullyPaid(b) && (b.Status == BookingStatus.AwaitingPayment || b.Payments.Any(p => p.Status == PaymentStatus.Pending))); }
<partial name="_DashboardHeader" model="Model" />
<div class="dashboard-board owner-board" data-dashboard="owner" data-view="overview">
    <partial name="_Metric" model='@(new DashboardMetric("Active requests", "inbox", Model.Requests.Count, "awaiting a sitter", Filled: Math.Min(8, Model.Requests.Count), Section: "requests"))' />
    <partial name="_Metric" model='@(new DashboardMetric("Bookings this month", "calendar", Model.ThisMonth, "a little care, all month", "lime", Math.Min(8, Model.ThisMonth), "bookings"))' />
    <article class="dash-card matching-card" data-sections="overview sitters"><span class="matching-eyebrow"><svg class="line-icon"><use href="#icon-sparkles" /></svg>A perfect little friendship</span><h2>Find the<br />perfect sitter<br />for your pet</h2><svg class="matching-dog" viewBox="0 0 180 180" aria-hidden="true"><circle cx="95" cy="95" r="84" fill="#f8e4ac"/><ellipse cx="56" cy="89" rx="23" ry="38" fill="#b8752e" transform="rotate(18 56 89)"/><ellipse cx="136" cy="89" rx="23" ry="38" fill="#b8752e" transform="rotate(-18 136 89)"/><ellipse cx="96" cy="100" rx="45" ry="51" fill="#d99a45"/><ellipse cx="96" cy="120" rx="28" ry="24" fill="#fff0c8"/><circle cx="79" cy="91" r="6" fill="#191b1c"/><circle cx="113" cy="91" r="6" fill="#191b1c"/><ellipse cx="96" cy="112" rx="10" ry="7" fill="#191b1c"/><path d="M87 126q9 8 18 0" fill="none" stroke="#191b1c" stroke-width="4" stroke-linecap="round"/></svg><a href="#sitters" class="btn btn-light btn-sm">Meet the sitters <svg class="line-icon"><use href="#icon-arrow" /></svg></a></article>
    <partial name="_Chart" model="Model" />
    <aside class="owner-actions" data-sections="overview">
        <div class="quick-tiles"><a asp-controller="CareRequests" asp-action="Create" class="quick-tile lime"><span class="round-icon"><svg class="line-icon"><use href="#icon-plus" /></svg></span><span class="tile-arrow">↗</span><strong>New request</strong></a><a asp-controller="Pets" asp-action="Create" class="quick-tile"><span class="round-icon"><svg class="line-icon paw-icon"><use href="#icon-paw" /></svg></span><span class="tile-arrow">↗</span><strong>Add a pet</strong></a><a href="#sitters" class="quick-tile"><span class="round-icon"><svg class="line-icon"><use href="#icon-search" /></svg></span><span class="tile-arrow">↗</span><strong>Find sitters</strong></a><button type="button" class="quick-tile" data-feature="Help center"><span class="round-icon"><svg class="line-icon"><use href="#icon-help" /></svg></span><span class="tile-arrow">↗</span><strong>Help center</strong></button></div>
        @if (pendingBooking is not null)
        {
            <div class="care-note"><div><svg class="line-icon"><use href="#icon-bell" /></svg><strong>Payment pending</strong></div><p>@pendingBooking.Request.Title is waiting for payment.</p><a asp-controller="OwnerBookings" asp-action="Details" asp-route-id="@pendingBooking.RequestId" class="btn btn-lime btn-sm"><svg class="line-icon"><use href="#icon-lock" /></svg>Review payment · @DashboardViewModel.Money(pendingBooking.TotalAmount, pendingBooking.Currency)</a></div>
        }
        else
        {
            <div class="care-note"><div><svg class="line-icon"><use href="#icon-shield" /></svg><strong>Peace of mind, always</strong></div><p>Keep their routines, favorite treats and care notes in one place.</p><a asp-controller="Pets" asp-action="Index" class="btn btn-lime btn-sm">Manage pet profiles ↗</a></div>
        }
    </aside>
    <partial name="_Bookings" model="Model" />
    <article class="dash-card recommendations-card" id="sitters" data-sections="overview sitters"><div class="card-heading"><div><span class="round-icon lime"><svg class="line-icon"><use href="#icon-sparkles" /></svg></span><h2>Sitters near you</h2></div></div><p class="card-description">A little company from experienced pet people in your city.</p>
        @if (Model.Sitters.Count == 0) { <div class="small-empty"><span class="round-icon"><svg class="line-icon paw-icon"><use href="#icon-paw" /></svg></span><p>New friendships take a moment.<small>@(string.IsNullOrEmpty(Model.Account.City) ? "Add your city in Settings to discover local sitters." : "Available sitters in your city will appear here.")</small></p></div><a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-light btn-sm full-width">Update your city ↗</a> }
        @foreach (var sitter in Model.Sitters) { <div class="sitter-row searchable" data-search="@sitter.User.FirstName @sitter.User.LastName @sitter.City @sitter.Bio"><span class="portal-avatar">@sitter.User.FirstName.FirstOrDefault()</span><div><strong>@sitter.User.FirstName @sitter.User.LastName</strong><small>@sitter.YearsOfExperience yrs experience · @sitter.City</small></div><span class="status-chip lime">@DashboardViewModel.Money(sitter.HourlyRate, sitter.Currency)/hr</span></div> }
    </article>
    <partial name="_Notifications" model="Model" />
    <article class="dash-card dashboard-pets" id="pets" data-sections="overview pets"><div class="card-heading"><h2>My pets</h2><a asp-controller="Pets" asp-action="Index" class="subtle-link">Manage ↗</a></div>
        @if (Model.Pets.Count == 0) { <div class="dashboard-empty"><span class="pet-emoji">🐾</span><h3>Every paw has a story</h3><p>Add your pet to make this space their own.</p><a asp-controller="Pets" asp-action="Create" class="btn btn-lime btn-sm">Add your first pet</a></div> }
        @foreach (var pet in Model.Pets) { <a class="dashboard-pet-row searchable" asp-controller="Pets" asp-action="Details" asp-route-id="@pet.Id" data-search="@pet.Name @pet.Species @pet.Breed"><span class="pet-emoji species-@pet.Species.ToLowerInvariant()">@DashboardViewModel.PetEmoji(pet.Species)</span><span><strong>@pet.Name</strong><small>@(pet.Breed ?? pet.Species)@(pet.AgeYears.HasValue ? " · " + pet.AgeYears + " yrs" : "")</small></span><svg class="line-icon"><use href="#icon-chevron" /></svg></a> }
    </article>
    <article class="dash-card summary-card" data-sections="overview payments"><h2>Booking summary</h2><dl><dt><i class="dot dark"></i>Completed</dt><dd>@Model.Completed</dd><dt><i class="dot lime"></i>Upcoming</dt><dd>@Model.Upcoming.Count()</dd><dt><i class="dot yellow"></i>Pending</dt><dd>@Model.Bookings.Count(b => b.Status is BookingStatus.Pending or BookingStatus.AwaitingPayment)</dd><dt><i class="dot gray"></i>Cancelled</dt><dd>@Model.Cancelled</dd></dl><div class="summary-total"><span>Paid in @Model.ReportYear · USD</span><strong>@DashboardViewModel.Money(Model.TotalPaid)</strong></div></article>
    <partial name="_Requests" model="Model" />
    <partial name="_Payments" model="Model" />
    <article class="dash-card feature-section" data-sections="messages reviews"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-heart" /></svg></span><h2>More ways to connect</h2><p>Messaging and reviews are on the way. Your pets and account details are ready to manage today.</p><a asp-controller="Pets" asp-action="Index" class="btn btn-dark btn-sm">Visit my pets ↗</a></article>
</div>
