@page
@model PetSitting.Areas.Identity.Pages.Account.LogoutModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["AuthVariant"] = "auth-recovery-page";
    ViewData["Title"] = Model.IsSignedIn ? "Log out" : "See you soon";
}
<section class="auth-form auth-recovery auth-confirmed" aria-labelledby="auth-heading">
    <a class="auth-back" asp-area="" asp-controller="Home" asp-action="Index"><svg class="line-icon back-arrow"><use href="#icon-arrow" /></svg>Back to home</a>
    <div class="confirmation-art" aria-hidden="true"><span class="confirmation-orbit"></span><span class="confirmation-envelope"><svg class="line-icon"><use href="#icon-shield" /></svg></span><span class="confirmation-seal"><svg class="line-icon"><use href="#icon-check" /></svg></span><span class="confirmation-spark spark-one">✦</span><span class="confirmation-spark spark-two">✦</span></div>
    @if (Model.IsSignedIn)
    {
        <p class="confirmation-eyebrow">UNTIL NEXT TIME</p>
        <h1 id="auth-heading">Ready to log out?</h1>
        <p class="auth-subtitle">Your requests, messages and bookings will be here when you return.</p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl"><button type="submit" class="auth-submit">Log out<svg class="line-icon"><use href="#icon-arrow" /></svg></button></form>
        <p class="recovery-resend"><a asp-area="" asp-controller="Dashboard" asp-action="Index">Back to your dashboard</a></p>
    }
    else
    {
        <p class="confirmation-eyebrow">YOU’RE ALL SIGNED OUT</p>
        <h1 id="auth-heading">See you soon.</h1>
        <p class="auth-subtitle">A little peace of mind for you. A whole lot of care for your pets.</p>
        <div class="confirmation-detail"><span class="confirmation-detail-icon"><svg class="line-icon"><use href="#icon-shield" /></svg></span><div><strong>You’re securely logged out</strong><p>Log in whenever you’re ready to pick up where you left off.</p></div></div>
        <a class="auth-submit" asp-page="Login">Log back in<svg class="line-icon"><use href="#icon-arrow" /></svg></a>
        <p class="recovery-resend"><a asp-area="" asp-controller="Home" asp-action="Index">Explore CareConnect</a></p>
    }
</section>
