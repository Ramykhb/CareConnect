@using BabySitting.ViewModels
@using System.Globalization
@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; Layout = "_PortalLayout"; var upcoming = Model.Upcoming.ToArray(); }
<partial name="_DashboardHeader" model="Model" />
<div class="dashboard-board sitter-board" data-dashboard="sitter" data-view="overview">
    <partial name="_Metric" model='@(new DashboardMetric("New requests", "inbox", Model.Requests.Count, "awaiting a little care", "dark", Math.Min(8, Model.Requests.Count), "requests"))' />
    <partial name="_Metric" model='@(new DashboardMetric("Active bookings", "calendar", upcoming.Length, $"{Model.InProgress} in progress", "lime", Math.Min(8, upcoming.Length), "bookings"))' />
    <partial name="_Metric" model='@(new DashboardMetric("Completed", "check", Model.Completed, "all time", Filled: Math.Min(8, Model.Completed), Section: "bookings"))' />
    <partial name="_Chart" model="Model" />
    <aside class="earnings-aside" data-sections="overview earnings reports"><article class="dash-card earnings-total dark"><div class="card-heading"><div><span class="round-icon"><svg class="line-icon"><use href="#icon-wallet" /></svg></span><h2>Earnings · @Model.ReportYear</h2></div><a href="#earnings" aria-label="View earnings">↗</a></div><strong>@DashboardViewModel.Money(Model.TotalPaid)</strong><p><span class="status-chip lime">@DashboardViewModel.Money(Model.MonthPaid)</span> this month · USD</p></article><article class="dash-card acceptance-card dark"><div class="card-heading"><h2>Acceptance rate</h2><span>All time</span></div><div class="acceptance-ring" style="--rate:@Model.AcceptanceRate.ToString(CultureInfo.InvariantCulture)"><span>@(Model.AcceptedOffers + Model.DeclinedOffers == 0 ? "—" : Model.AcceptanceRate + "%")</span></div><p>@Model.AcceptedOffers accepted · @Model.DeclinedOffers declined</p></article></aside>
    <partial name="_Requests" model="Model" />
    <article class="dash-card today-card" data-sections="overview bookings"><div class="card-heading"><h2>Today · @DashboardViewModel.Local(Model.Now).ToString("ddd d MMM")</h2><a href="#bookings" class="subtle-link">Calendar ↗</a></div>
        @if (!Model.Today.Any()) { <div class="dashboard-empty"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-sun" /></svg></span><h3>A little room to breathe</h3><p>You have no visits scheduled for today.</p><a href="#requests" class="text-action">Find your next family to help ↗</a></div> }
        @foreach (var booking in Model.Today) { var children = DashboardViewModel.Children(booking.Request); <div class="today-row searchable" data-search="@children @booking.Request.Title"><time>@DashboardViewModel.Local(booking.StartsAtUtc).ToString("h:mm tt")<small>today</small></time><span class="pet-emoji">🧸</span><div><strong>@children</strong><small>@DashboardViewModel.Service(booking.Request.ServiceType) · @booking.Request.City</small></div><span class="status-chip @DashboardViewModel.StatusClass(booking.Status)">@DashboardViewModel.Status(booking.Status)</span></div> }
    </article>
    <article class="dash-card booking-activity" data-sections="overview reports"><div class="card-heading"><h2>Booking activity</h2><span><i class="dot dark"></i>Bookings <i class="dot lime"></i>Completed</span></div><div class="week-chart" aria-label="Bookings this week, by day">
        @for (var i = 0; i < 7; i++) { var day = DashboardViewModel.Local(Model.Now).Date.AddDays(-6+i); var dayBookings = Model.Bookings.Where(b => DashboardViewModel.Local(b.StartsAtUtc).Date == day).ToArray(); var total = dayBookings.Length; var complete = dayBookings.Count(b => b.Status == BookingStatus.Completed); <div title="@day.ToString("ddd d MMM"): @total bookings, @complete completed"><div class="week-track"><i style="height:@(Math.Min(100, total * 18))%"></i><i class="lime" style="height:@(Math.Min(100, complete * 18))%"></i></div><span>@day.ToString("ddd")[..1]</span></div> }
    </div><p class="chart-caption">Last 7 days · @Model.Bookings.Count(b => DashboardViewModel.Local(b.StartsAtUtc).Date >= DashboardViewModel.Local(Model.Now).Date.AddDays(-6) && DashboardViewModel.Local(b.StartsAtUtc).Date <= DashboardViewModel.Local(Model.Now).Date) bookings</p></article>
    <partial name="_Notifications" model="Model" />
    <article class="dash-card sitter-quick-actions" data-sections="overview"><h2>Quick actions</h2><a href="#availability" class="quick-action lime"><span class="round-icon"><svg class="line-icon"><use href="#icon-calendar" /></svg></span>Set availability <span>↗</span></a><button type="button" class="quick-action" data-feature="Update pricing"><span class="round-icon"><svg class="line-icon"><use href="#icon-wallet" /></svg></span>Update pricing <span>↗</span></button><button type="button" class="quick-action" data-export><span class="round-icon"><svg class="line-icon"><use href="#icon-download" /></svg></span>Export monthly report <span>↗</span></button><button type="button" class="quick-action" data-feature="Request payout"><span class="round-icon"><svg class="line-icon"><use href="#icon-card" /></svg></span>Request payout <span>↗</span></button></article>
    <partial name="_Bookings" model="Model" />
    <partial name="_Payments" model="Model" />
    <article class="dash-card availability-card" data-sections="availability"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-calendar" /></svg></span><h2>Your availability</h2><p>@(Model.Profile is null ? "Your sitter profile hasn’t been set up yet. Profile setup and availability scheduling are coming soon." : Model.Profile.IsAvailable ? $"You’re currently accepting requests in {Model.Profile.City}. Availability scheduling is coming soon." : "You’re currently unavailable. Availability scheduling is coming soon.")</p><a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-dark btn-sm">Manage account details ↗</a></article>
    <article class="dash-card feature-section" data-sections="reviews"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-star" /></svg></span><h2>A little love from the families you help</h2><p>The reviews experience is on the way. Keep making tails wag.</p></article>
    <article class="dash-card report-toolbar" data-sections="reports"><div class="card-heading"><h2>Monthly report · @Model.ReportYear</h2><button type="button" class="btn btn-dark btn-sm" data-export><svg class="line-icon"><use href="#icon-download" /></svg>Download CSV</button></div><p class="card-description">Monthly booking hours and received payments in USD.</p></article>
    <div id="report-data" hidden>@foreach (var month in Model.Months) { <span data-month="@month.Label" data-hours="@month.Hours.ToString(CultureInfo.InvariantCulture)" data-paid="@month.Paid.ToString(CultureInfo.InvariantCulture)"></span> }</div>
</div>
