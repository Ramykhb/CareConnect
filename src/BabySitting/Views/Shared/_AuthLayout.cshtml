<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7f3" />
    <title>@ViewData["Title"] · CareConnect Babysitting</title>
    <link rel="stylesheet" href="~/css/baby-auth.css" asp-append-version="true" />
</head>
<body class="baby-auth @ViewData["AuthVariant"]">
    <a class="auth-skip" href="#auth-main">Skip to form</a>
    <partial name="_BabyIcons" />
    <div class="auth-shell">
        <aside class="auth-story" aria-label="CareConnect babysitting">
            <div class="story-top"><a class="auth-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-icon"><svg><use href="#icon-family" /></svg></span>CareConnect</a><span class="portal-badge"><svg><use href="#icon-family" /></svg>Family care portal</span></div>
            <h2>Big care for <br />their little <br />world.</h2>
            <div class="story-review family-note"><div class="family-note-heading"><svg class="line-icon"><use href="#icon-heart" /></svg>A little more reassurance</div><p>Familiar routines. Kind faces.<br />Room for them to be themselves.</p><div class="review-person"><span class="review-avatar" aria-hidden="true"><svg class="line-icon"><use href="#icon-check" /></svg></span><span>Thoughtful care, every step.</span></div></div>
            <img class="story-family" src="~/images/auth-family.svg" alt="A caregiver and child sharing a happy moment, with a little toy rabbit nearby" width="490" height="470" />
        </aside>
        <main id="auth-main" class="auth-main">@RenderBody()</main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/baby-auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
