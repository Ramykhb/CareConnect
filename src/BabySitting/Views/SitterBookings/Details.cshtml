@using BabySitting.ViewModels
@using BabySitting.Services.Bookings
@model SitterBookingsViewModel
@{
    Layout = "_PortalLayout"; var booking = Model.Booking!;
    ViewData["Title"] = "Booking details"; ViewData["Breadcrumb"] = "Bookings / #" + SitterBookingsViewModel.Reference(booking); ViewData["PortalClass"] = "booking-portal";
    var paid = BookingRules.FullyPaid(booking); var tasks = BookingRules.Tasks(booking).ToArray(); var editable = BookingRules.CanUpdateCare(booking);
}
@section Styles { <link rel="stylesheet" href="~/css/baby-scheduling.css" asp-append-version="true" /> }
<section class="schedule-heading booking-details-heading"><div class="booking-details-title"><a asp-action="Index" class="round-icon" aria-label="Back to bookings"><svg class="line-icon"><use href="#icon-back" /></svg></a><div><div><h1>@DashboardViewModel.Service(booking.Request.ServiceType) · @SitterBookingsViewModel.ChildrenSummary(booking)</h1><span class="status-chip @BookingRules.Css(booking)">@BookingRules.Label(booking)</span><span class="status-chip @(paid ? "lime" : "yellow")">@(paid ? "✓ Payment successful" : "Payment pending")</span></div><p>Booking #@SitterBookingsViewModel.Reference(booking) · @booking.Customer.FirstName @booking.Customer.LastName · @DashboardViewModel.Local(booking.StartsAtUtc).ToString("ddd d MMM") → @DashboardViewModel.Local(booking.EndsAtUtc).ToString("ddd d MMM")</p></div></div><div class="schedule-heading-actions"><button type="button" class="btn btn-ghost btn-sm" data-open-dialog="report-booking-issue"><svg class="line-icon"><use href="#icon-alert" /></svg>Report issue</button><a href="#send-care-update" class="btn btn-light btn-sm"><svg class="line-icon"><use href="#icon-chat" /></svg>Message parent</a></div></section>
<div class="booking-details-grid">
    <section class="dash-card booking-status-card"><div class="card-heading"><h2>Update status</h2><span class="sync-label"><i></i>Updated just now</span></div>
        <div class="booking-status-step done"><span class="step-icon"><svg class="line-icon"><use href="#icon-check" /></svg></span><div><strong>@(booking.Status is BookingStatus.Pending or BookingStatus.Rejected or BookingStatus.Cancelled ? "Booking created" : "Accepted")</strong><small>@DashboardViewModel.Local(booking.CreatedAtUtc).ToString("ddd d MMM · h:mm tt")</small></div><span>Done</span></div>
        <div class="booking-status-step @(booking.Status is BookingStatus.InProgress or BookingStatus.Completed ? "done" : "current")"><span class="step-icon">@if (booking.Status is BookingStatus.InProgress or BookingStatus.Completed) { <svg class="line-icon"><use href="#icon-check" /></svg> } else { <span>2</span> }</span><div><strong>Checked in · care started</strong><small>@(booking.StartedAtUtc is null ? "Start at the scheduled time, after payment succeeds." : DashboardViewModel.Local(booking.StartedAtUtc.Value).ToString("ddd d MMM · h:mm tt") + " · parent notified")</small></div>
        @if (booking.Status is BookingStatus.InProgress or BookingStatus.Completed) { <span>Done</span> } else if (BookingRules.StartBlock(booking, Model.Now) is null) { <form asp-action="Transition" method="post"><input type="hidden" name="Id" value="@booking.Id" /><input type="hidden" name="Version" value="@Convert.ToBase64String(booking.RowVersion)" /><button type="submit" class="btn btn-dark btn-sm" name="Action" value="start"><svg class="line-icon"><use href="#icon-bolt" /></svg>Start care</button></form> } else { <span class="step-waiting">Waiting</span> }</div>
        <div class="booking-status-step @(booking.Status == BookingStatus.Completed ? "done" : editable ? "current" : "")"><span class="step-icon">@if (booking.Status == BookingStatus.Completed) { <svg class="line-icon"><use href="#icon-check" /></svg> } else { <span>3</span> }</span><div><strong>@(booking.Status == BookingStatus.Completed ? "Care completed" : "Complete the stay")</strong><small>@(booking.CompletedAtUtc is null ? "The parent is notified when you finish care." : DashboardViewModel.Local(booking.CompletedAtUtc.Value).ToString("ddd d MMM · h:mm tt") + " · parent notified")</small></div>@if (editable) { <form asp-action="Transition" method="post" data-status-confirm="Mark this booking completed? The parent will be notified and the care checklist will become read-only."><input type="hidden" name="Id" value="@booking.Id" /><input type="hidden" name="Version" value="@Convert.ToBase64String(booking.RowVersion)" /><button type="submit" class="btn btn-dark btn-sm" name="Action" value="complete"><svg class="line-icon"><use href="#icon-check" /></svg>Mark as completed</button></form> } else { <span>@(booking.Status == BookingStatus.Completed ? "Done" : "Waiting")</span> }</div>
        <div class="booking-status-note"><svg class="line-icon"><use href="#icon-help" /></svg>@(booking.Status is BookingStatus.Cancelled or BookingStatus.Rejected ? "This booking is closed. Care status cannot be changed." : !paid ? "Full payment is required before this booking can start." : booking.Status is BookingStatus.Confirmed or BookingStatus.AwaitingPayment && Model.Now < booking.StartsAtUtc ? "Care can start at " + DashboardViewModel.Local(booking.StartsAtUtc).ToString("ddd d MMM · h:mm tt") + "." : "Status changes are saved to the booking and shared with the parent.")</div>
    </section>
    <aside class="booking-contact-column"><section class="dash-card booking-contact"><div><span class="portal-avatar">@booking.Customer.FirstName.FirstOrDefault()</span><div><h2>@booking.Customer.FirstName @booking.Customer.LastName</h2><small>Parent @if (!string.IsNullOrWhiteSpace(booking.Customer.PhoneNumber)) { <span>· @booking.Customer.PhoneNumber</span> }</small></div></div><p><svg class="line-icon"><use href="#icon-pin" /></svg>@(string.IsNullOrWhiteSpace(booking.Request.ServiceAddress) ? booking.Request.City : booking.Request.ServiceAddress + " · " + booking.Request.City)</p>@if (!string.IsNullOrWhiteSpace(booking.Customer.PhoneNumber)) { <a class="owner-call" href="tel:@booking.Customer.PhoneNumber"><svg class="line-icon"><use href="#icon-phone" /></svg>Call parent · @booking.Customer.PhoneNumber</a> } else { <div class="owner-contact-note">No phone number has been shared. Use a booking update to contact the parent.</div> }</section>
        <section class="dash-card booking-payment dark"><div class="card-heading"><h2>Payment</h2><span class="status-chip @(paid ? "lime" : "yellow")">@(paid ? "✓ Payment successful" : "Payment pending")</span></div><strong>@DashboardViewModel.Money(booking.TotalAmount, booking.Currency)</strong><p>@DashboardViewModel.Money(BookingRules.Paid(booking), booking.Currency) received · @booking.Currency</p><small>Booking total. Payment and payout processing are managed separately.</small></section>
    </aside>
    <section class="dash-card care-checklist" id="care-checklist"><div class="card-heading"><h2>Care checklist</h2><span class="subtle-link">@tasks.Count(t => t.Completed)/@tasks.Length done</span></div>
        @if (tasks.Length == 0) { <p class="schedule-muted">No care instructions have been added yet. You can add a task below.</p> }
        @foreach (var task in tasks) { <form asp-action="Task" method="post" class="care-task" data-preserve-scroll><input type="hidden" name="Id" value="@booking.Id" /><input type="hidden" name="Key" value="@task.Key" /><label><input type="checkbox" name="Completed" value="true" checked="@task.Completed" disabled="@(!editable)" data-care-toggle /><span><strong>@task.Label</strong>@if (!string.IsNullOrEmpty(task.Note)) { <small>@task.Note</small> }</span></label><input type="hidden" name="Completed" value="false" />@if (task.DueAtUtc is not null) { <time>@DashboardViewModel.Local(task.DueAtUtc.Value).ToString("d MMM h:mm tt")</time> }@if (editable) { <button class="care-task-save" type="submit">Save</button> }</form> }
        @if (booking.Status is BookingStatus.InProgress or BookingStatus.Confirmed or BookingStatus.AwaitingPayment) { <details class="care-add-task"><summary>+ Add a task</summary><form asp-action="AddTask" method="post"><input type="hidden" name="Id" value="@booking.Id" /><label>Task<input name="Label" maxlength="200" required placeholder="e.g. Refill the water bowl" /></label><label>Due time (Beirut, optional)<input name="DueAtLocal" type="datetime-local" min="@DashboardViewModel.Local(booking.StartsAtUtc).ToString("yyyy-MM-ddTHH:mm")" max="@DashboardViewModel.Local(booking.EndsAtUtc).ToString("yyyy-MM-ddTHH:mm")" /></label><button type="submit" class="btn btn-dark btn-sm">Add task</button></form></details> }
    </section>
    <section class="dash-card photo-update-card" id="send-care-update"><h2>Send a photo update</h2>
        @if (booking.Status is BookingStatus.InProgress or BookingStatus.Completed) { <form asp-action="SendUpdate" method="post" enctype="multipart/form-data" data-update-form><input type="hidden" name="Id" value="@booking.Id" /><input type="hidden" name="ClientToken" value="@Model.UpdateToken" /><div class="photo-attachments"><span class="care-pet-portrait" aria-hidden="true">🧸</span><label class="care-add-photo"><svg class="line-icon"><use href="#icon-photo" /></svg><span>Add photo</span><input type="file" name="Photo" accept="image/jpeg,image/png,image/webp" data-care-photo /></label><img class="care-photo-preview" alt="Selected photo preview" hidden data-care-preview /></div><small class="photo-upload-hint">JPEG, PNG or WebP · up to 5 MB</small><div class="photo-message"><textarea name="Message" maxlength="2000" rows="2" placeholder="Share how their day is going…" aria-label="Update for the parent"></textarea><button type="submit" class="btn btn-dark btn-sm"><svg class="line-icon"><use href="#icon-send" /></svg>Send</button></div><p class="photo-error" role="alert" hidden></p></form> } else { <p class="schedule-muted">Photo updates are available once care has started.</p> }
        @foreach (var update in booking.Updates.OrderByDescending(u => u.CreatedAtUtc).Take(5)) { <article class="saved-care-update"><div><strong>@(update.IsIssue ? "Issue reported" : "Update sent")</strong><time>@DashboardViewModel.Local(update.CreatedAtUtc).ToString("d MMM h:mm tt")</time></div>@if (update.HasPhoto) { <a asp-controller="BookingPhotos" asp-action="Image" asp-route-id="@update.Id" target="_blank" rel="noopener"><img src="@Url.Action("Image", "BookingPhotos", new { id = update.Id })" alt="Photo shared with the parent" loading="lazy" /></a> }<p>@update.Message</p></article> }
    </section>
</div>
<dialog class="dashboard-dialog" id="report-booking-issue" aria-labelledby="report-issue-title"><button type="button" class="round-icon dialog-close" data-close aria-label="Close"><svg class="line-icon"><use href="#icon-close" /></svg></button><span class="round-icon lime"><svg class="line-icon"><use href="#icon-alert" /></svg></span><h2 id="report-issue-title">Report a booking issue</h2><p>Describe what happened. Your note is saved to the booking and the parent receives a notification.</p><form asp-action="ReportIssue" method="post" class="issue-form"><input type="hidden" name="Id" value="@booking.Id" /><input type="hidden" name="ClientToken" value="@Model.IssueToken" /><textarea name="Message" maxlength="2000" required rows="5" aria-label="Describe the issue"></textarea><button type="submit" class="btn btn-dark btn-sm">Send report</button></form></dialog>
@if (booking.Status == BookingStatus.Cancelled)
{
    <section class="dash-card cancel-booking-card"><h2>Booking cancelled</h2><p>@(booking.CancellationReason ?? "This booking was cancelled.")</p></section>
}
@if (BabySitting.Services.Bookings.BookingCancellationService.CanCancel(booking))
{
    <section class="dash-card cancel-booking-card"><h2>Cancel this booking</h2><p>You can cancel until care starts. The parent is notified and the request reopens for other sitters.</p>
        <form asp-action="Cancel" asp-route-id="@booking.Id" method="post" class="cancel-booking-form"><input type="hidden" name="version" value="@Convert.ToBase64String(booking.RowVersion)" /><textarea name="reason" maxlength="900" required rows="3" aria-label="Reason for cancelling" placeholder="Tell the parent why…"></textarea><button type="submit" class="btn btn-danger btn-sm">Cancel booking</button></form></section>
}
<partial name="_StatusConfirmation" />
@section Scripts { <script src="~/js/baby-scheduling.js" asp-append-version="true"></script> }
