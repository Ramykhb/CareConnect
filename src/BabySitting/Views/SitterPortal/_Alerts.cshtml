@model (BabySitting.ViewModels.AlertPreferencesForm Form, bool Settings)
<section class="dash-card alert-preferences"><h2>Alert preferences</h2><form asp-action="SaveAlerts" method="post"><input type="hidden" name="settings" value="@Model.Settings.ToString().ToLowerInvariant()" /><input type="hidden" name="Alerts.Version" value="@Model.Form.Version" /><table class="alert-channel-table"><thead><tr><th><span class="visually-hidden">Alert type</span></th><th>Email</th><th>In-app</th><th>SMS</th></tr></thead><tbody>
@foreach (var row in new[] { ("Requests", "New request alerts", Model.Form.Requests), ("Bookings", "Booking updates", Model.Form.Bookings), ("Payments", "Payment notifications", Model.Form.Payments), ("Reviews", "Reviews", Model.Form.Reviews) })
{
    <tr><th>@row.Item2</th><td><input class="alert-switch" type="checkbox" disabled aria-label="Email @row.Item2 unavailable" title="Email alerts are not connected yet" /></td><td><input class="alert-switch" type="checkbox" name="Alerts.@row.Item1" value="true" checked="@row.Item3" aria-label="In-app @row.Item2" /><input type="hidden" name="Alerts.@row.Item1" value="false" /></td><td><input class="alert-switch" type="checkbox" disabled aria-label="SMS @row.Item2 unavailable" title="SMS delivery is not connected yet" /></td></tr>
}
</tbody></table><label class="request-sound-option"><svg class="line-icon"><use href="#icon-bell" /></svg><span>Play a sound when a new request arrives</span><input class="alert-switch" type="checkbox" name="Alerts.RequestSound" value="true" checked="@Model.Form.RequestSound" /><input type="hidden" name="Alerts.RequestSound" value="false" /></label><div class="alert-form-actions"><button type="button" class="btn btn-light btn-sm" data-test-alert-sound>Test sound</button><button type="submit" class="btn btn-dark btn-sm">Save alerts</button></div><p class="portal-muted alert-channel-note">In-app alerts are available. Email and SMS delivery are not connected yet.</p></form></section>
