@using BabySitting.ViewModels
@model SitterReviewsViewModel
@{ ViewData["Title"] = "Reviews"; ViewData["PortalClass"] = "sitter-portal-page"; var peak = Math.Max(1, Model.Reviews.GroupBy(r => r.Rating).Select(g => g.Count()).DefaultIfEmpty(0).Max()); }
@section Styles { <link rel="stylesheet" href="~/css/baby-account.css" asp-append-version="true" /> }
<section class="account-page-heading"><div><h1>Reviews &amp; feedback</h1><p>Kind words, helpful feedback and the care stories you share with parents.</p></div><a asp-controller="SitterBookings" asp-action="Index" asp-route-status="completed" class="btn btn-light btn-sm">Completed bookings ↗</a></section>
<div class="reviews-overview"><section class="dash-card review-score"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-star" /></svg></span><h2>Your overall rating</h2><strong>@(Model.Average?.ToString("0.0") ?? "—")</strong><span class="rating-stars @(Model.Average is null ? "empty" : "")">★★★★★</span><p>Based on @Model.Reviews.Count verified booking @(Model.Reviews.Count == 1 ? "review" : "reviews")</p></section><section class="dash-card review-distribution"><h2>Every care story counts</h2>@for (var stars = 5; stars >= 1; stars--) { var count = Model.Reviews.Count(r => r.Rating == stars); <a asp-action="Reviews" asp-route-stars="@stars" class="rating-meter"><span>@stars★</span><div><i style="width:@((count * 100m / peak).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></i></div><small>@count</small></a> }</section><section class="dash-card review-replies lime"><h2>A thoughtful reply goes a long way</h2><strong>@Model.Reviews.Count(r => string.IsNullOrEmpty(r.SitterReply))</strong><p>reviews are waiting for your response.</p><a asp-action="Reviews" asp-route-unanswered="true" class="btn btn-light btn-sm">View unanswered ↗</a></section></div>
<form asp-action="Reviews" method="get" class="reviews-toolbar"><label class="portal-search"><svg class="line-icon"><use href="#icon-search" /></svg><input type="search" name="search" value="@Model.Search" maxlength="150" placeholder="Search parents, children or feedback…" aria-label="Search reviews" /></label><label><span class="visually-hidden">Rating</span><select name="stars"><option value="">All ratings</option>@for (var stars = 5; stars >= 1; stars--) { <option value="@stars" selected="@(Model.Stars == stars)">@stars stars</option> }</select></label><label><span class="visually-hidden">Sort reviews</span><select name="sort"><option value="recent" selected="@(Model.Sort == "recent")">Most recent</option><option value="highest" selected="@(Model.Sort == "highest")">Highest rating</option><option value="lowest" selected="@(Model.Sort == "lowest")">Lowest rating</option></select></label><label class="unanswered-filter"><input type="checkbox" name="unanswered" value="true" checked="@Model.Unanswered" />Unanswered</label><button class="btn btn-dark btn-sm" type="submit">Apply</button></form>
<div class="review-cards">
@foreach (var review in Model.Visible)
{
    <article class="dash-card owner-review" id="review-@review.Id"><div class="review-person"><span class="portal-avatar">@review.Reviewer.FirstName.FirstOrDefault()</span><div><h2>@review.Reviewer.FirstName @review.Reviewer.LastName</h2><small>@DashboardViewModel.Service(review.Booking.Request.ServiceType) · @SitterBookingsViewModel.ChildrenSummary(review.Booking)</small></div><div><span class="review-rating" aria-label="@review.Rating out of 5 stars">@(new string('★', review.Rating))<span>@(new string('☆', 5-review.Rating))</span></span><time>@DashboardViewModel.Local(review.CreatedAtUtc).ToString("d MMM yyyy")</time></div></div><blockquote>@(string.IsNullOrWhiteSpace(review.Comment) ? "This parent left a rating without a written comment." : review.Comment)</blockquote><a asp-controller="SitterBookings" asp-action="Details" asp-route-id="@review.BookingId" class="review-booking-link">Verified completed booking · #@SitterBookingsViewModel.Reference(review.Booking) ↗</a>
    @if (!string.IsNullOrWhiteSpace(review.SitterReply)) { <div class="saved-review-reply"><span class="round-icon"><svg class="line-icon"><use href="#icon-chat" /></svg></span><div><strong>Your reply <small>@DashboardViewModel.Local(review.RepliedAtUtc ?? review.CreatedAtUtc).ToString("d MMM yyyy")</small></strong><p>@review.SitterReply</p></div></div> }
    <details class="review-reply-editor"><summary>@(string.IsNullOrWhiteSpace(review.SitterReply) ? "↳ Reply to this review" : "Edit your reply")</summary><form asp-action="Reply" method="post" class="portal-form"><input type="hidden" name="Id" value="@review.Id" /><input type="hidden" name="Version" value="@Convert.ToBase64String(review.RowVersion)" /><label class="visually-hidden" for="reply-@review.Id">Your reply</label><textarea id="reply-@review.Id" name="Reply" maxlength="2000" rows="3" required placeholder="Thank the parent or respond to their feedback…">@review.SitterReply</textarea><button type="submit" class="btn btn-dark btn-sm">Save reply</button></form></details></article>
}
@if (!Model.Visible.Any()) { <section class="dash-card portal-empty"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-star" /></svg></span><h3>@(Model.Reviews.Count == 0 ? "Your first review is still ahead" : "No reviews match these filters")</h3><p>@(Model.Reviews.Count == 0 ? "Feedback from parents of completed bookings will appear here." : "Try a different rating or search term.")</p></section> }
</div>
@section Scripts { <script src="~/js/baby-account.js" asp-append-version="true"></script> }
