@using System.Globalization
@using BabySitting.ViewModels
@model SitterReportViewModel
@{ ViewData["Title"] = "Analytics & Reports"; ViewData["PortalClass"] = "sitter-portal-page"; ViewData["ReportChart"] = "analytics"; var months = Model.Months.ToArray(); var rating = Model.AverageRating; var maxStars = Math.Max(1, Model.PeriodReviews.GroupBy(r => r.Rating).Select(g => g.Count()).DefaultIfEmpty(0).Max()); }
@section Styles { <link rel="stylesheet" href="~/css/baby-account.css" asp-append-version="true" /> }
<section class="account-page-heading"><div><h1>Analytics &amp; reports</h1><p>Performance across your responses, completed bookings, earnings and reviews.</p></div><div class="account-heading-actions"><button class="btn btn-light btn-sm" type="button" data-portal-dialog="report-range"><svg class="line-icon"><use href="#icon-calendar" /></svg>@Model.From.ToString("MMM") – @Model.To.ToString("MMM yyyy")<svg class="line-icon"><use href="#icon-down" /></svg></button><a asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-currency="@Model.Currency" asp-route-format="pdf" class="btn btn-light btn-sm"><svg class="line-icon"><use href="#icon-download" /></svg>Export PDF</a><a asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-currency="@Model.Currency" asp-route-format="xlsx" class="btn btn-dark btn-sm"><svg class="line-icon"><use href="#icon-download" /></svg>Export Excel</a></div></section>
<div class="portal-kpis">@foreach (var metric in new[] { ("Total requests", "inbox", Model.PeriodOffers.Count(), "Requests you responded to"), ("Accepted", "check", Model.Accepted, "Current outcomes for this period"), ("Rejected", "close", Model.Rejected, "Current outcomes for this period"), ("Completed services", "star", Model.Completed, "Completed during this period") }) { <article class="dash-card portal-kpi"><div><span class="round-icon"><svg class="line-icon"><use href="#icon-@metric.Item2" /></svg></span><h2>@metric.Item1</h2></div><strong>@metric.Item3.ToString("N0")</strong><small>@metric.Item4</small></article> }</div>
<div class="analytics-chart-row"><partial name="_MonthlyBars" model="Model" /><section class="dash-card acceptance-report"><div class="card-heading"><h2>Acceptance rate</h2><span class="status-chip green">✓ Accepted</span></div><div class="report-ring" style="--rate:@((Model.AcceptanceRate ?? 0).ToString(CultureInfo.InvariantCulture))"><span>@(Model.AcceptanceRate?.ToString("0.#") + (Model.AcceptanceRate is null ? "—" : "%"))</span></div><div class="acceptance-facts"><span><strong>@Model.Accepted</strong><small>accepted</small></span><span><strong>@Model.Rejected</strong><small>rejected</small></span><span><strong>@(Model.ReplyMinutes is null ? "—" : Model.ReplyMinutes.Value.ToString("0") + " min")</strong><small>avg reply</small></span></div></section></div>
<div class="analytics-insights"><section class="dash-card service-breakdown"><h2>Most requested services</h2>@{ var total = Math.Max(1, Model.PeriodOffers.Count()); }@foreach (var group in Model.PeriodOffers.GroupBy(o => o.Request.ServiceType).OrderByDescending(g => g.Count())) { var percent = group.Count() * 100m / total; <div class="service-meter"><div><span>@DashboardViewModel.Service(group.Key)</span><small>@group.Count() · @percent.ToString("0")%</small></div><div><i style="width:@percent.ToString("0.##", CultureInfo.InvariantCulture)%"></i></div></div> }@if (!Model.PeriodOffers.Any()) { <p class="portal-muted">Your service mix will appear after you respond to requests.</p> }</section>
<section class="dash-card satisfaction-card"><h2>Customer satisfaction</h2><div class="rating-overview"><strong>@(rating?.ToString("0.0") ?? "—")</strong><div><span class="rating-stars" aria-label="@(rating?.ToString("0.0") ?? "No") stars">★★★★★</span><small>@Model.PeriodReviews.Count() reviews · @(Model.PeriodReviews.Any() ? (Model.PeriodReviews.Count(r => r.Rating == 5) * 100m / Model.PeriodReviews.Count()).ToString("0") + "% five-star" : "No ratings yet")</small></div></div>@for (var star = 5; star >= 1; star--) { var count = Model.PeriodReviews.Count(r => r.Rating == star); <div class="rating-meter"><span>@star★</span><div><i style="width:@((count*100m/maxStars).ToString("0.##", CultureInfo.InvariantCulture))%"></i></div><small>@count</small></div> }</section>
<section class="dash-card monthly-income lime"><div class="card-heading"><h2>Period earnings</h2><svg class="line-icon"><use href="#icon-trend" /></svg></div><strong>@DashboardViewModel.Money(Model.Gross, Model.Currency)</strong><p>Successful payments · @Model.Currency</p>@{ var peak = Math.Max(1m, months.Select(m => m.Earnings).DefaultIfEmpty(0).Max()); var points = string.Join(" ", months.Select((m, i) => $"{(i * 210d / Math.Max(1, months.Length-1)).ToString("0.##", CultureInfo.InvariantCulture)},{(95 - (double)(m.Earnings/peak)*75).ToString("0.##", CultureInfo.InvariantCulture)}")); }<svg viewBox="0 0 214 110" role="img" aria-label="Monthly successful payments in @Model.Currency"><polyline points="@points" fill="none" stroke="#191b1c" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></section></div>
<section class="dash-card summary-report"><div class="card-heading"><h2>Monthly summary report</h2><div><a asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-currency="@Model.Currency" asp-route-format="pdf" class="btn btn-light btn-sm">PDF</a><a asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-currency="@Model.Currency" asp-route-format="xlsx" class="btn btn-light btn-sm">XLSX</a></div></div><div class="portal-table-scroll"><table class="portal-table"><thead><tr><th>Month</th><th class="numeric">Requests</th><th class="numeric">Accepted</th><th class="numeric">Rejected</th><th class="numeric">Completed</th><th class="numeric">Earnings · @Model.Currency</th><th class="numeric">Avg rating</th></tr></thead><tbody>@foreach (var month in months.Reverse()) { <tr><td>@month.Month.ToString("MMM yyyy")</td><td class="numeric">@month.Requests</td><td class="numeric">@month.Accepted</td><td class="numeric">@month.Rejected</td><td class="numeric">@month.Completed</td><td class="numeric">@DashboardViewModel.Money(month.Earnings, Model.Currency)</td><td class="numeric">@(month.Rating?.ToString("0.0") ?? "—")</td></tr> }</tbody></table></div><p class="report-method">Request counts use your recorded responses and their current outcomes. Pending decisions are excluded from the acceptance rate. No currency conversion is applied.</p></section>
<dialog class="dashboard-dialog" id="report-range" aria-labelledby="report-range-title"><button type="button" class="round-icon dialog-close" data-close aria-label="Close"><svg class="line-icon"><use href="#icon-close" /></svg></button><h2 id="report-range-title">Choose a reporting period</h2><form asp-action="Analytics" method="get" class="portal-form"><label>From<input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" min="2000-01-01" max="@BabySitting.Services.Scheduling.ScheduleMath.LocalDate(Model.Now).ToString("yyyy-MM-dd")" required /></label><label>To<input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" max="@BabySitting.Services.Scheduling.ScheduleMath.LocalDate(Model.Now).ToString("yyyy-MM-dd")" required /></label><label>Currency<select name="currency">@foreach (var code in Model.Currencies) { <option value="@code" selected="@(code == Model.Currency)">@code</option> }</select></label><p>Choose a period of up to one year.</p><button class="btn btn-dark btn-sm" type="submit">Update report</button></form></dialog>
@section Scripts { <script src="~/js/baby-account.js" asp-append-version="true"></script> }
