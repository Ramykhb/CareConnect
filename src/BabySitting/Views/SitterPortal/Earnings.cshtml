@using BabySitting.ViewModels
@model SitterReportViewModel
@{ ViewData["Title"] = "Earnings"; ViewData["PortalClass"] = "sitter-portal-page"; var pending = Model.Payouts.FirstOrDefault(p => p.Currency == Model.Currency && p.Status == PayoutStatus.Requested); }
@section Styles { <link rel="stylesheet" href="~/css/baby-account.css" asp-append-version="true" /> }
<section class="account-page-heading"><div><h1>Earnings &amp; payments</h1><p>Keep track of payment records, available earnings and your payout requests.</p></div><div class="account-heading-actions"><a asp-action="EarningsCsv" asp-route-year="@Model.From.Year" asp-route-currency="@Model.Currency" class="btn btn-light btn-sm"><svg class="line-icon"><use href="#icon-download" /></svg>Export CSV</a><button type="button" class="btn btn-dark btn-sm" data-portal-dialog="payout-dialog" disabled="@(Model.AvailableBalance <= 0)"><svg class="line-icon"><use href="#icon-wallet" /></svg>Request payout</button></div></section>
<form asp-action="Earnings" method="get" class="report-period-form earnings-period"><label>Year<select name="year">@for (var y = BabySitting.Services.Scheduling.ScheduleMath.LocalDate(Model.Now).Year; y >= Math.Max(2000, BabySitting.Services.Scheduling.ScheduleMath.LocalDate(Model.Now).Year - 10); y--) { <option value="@y" selected="@(y == Model.From.Year)">@y</option> }</select></label><label>Currency<select name="currency">@foreach (var code in Model.Currencies) { <option value="@code" selected="@(code == Model.Currency)">@code</option> }</select></label><button class="btn btn-light btn-sm" type="submit">Apply</button></form>
<div class="portal-kpis"><article class="dash-card portal-kpi"><div><span class="round-icon"><svg class="line-icon"><use href="#icon-wallet" /></svg></span><h2>Total earnings @Model.From.Year</h2></div><strong>@DashboardViewModel.Money(Model.Gross, Model.Currency)</strong><small>Successful payments · @Model.Currency</small></article><article class="dash-card portal-kpi"><div><span class="round-icon"><svg class="line-icon"><use href="#icon-calendar" /></svg></span><h2>@(Model.From.Year == BabySitting.Services.Scheduling.ScheduleMath.LocalDate(Model.Now).Year ? "This month" : new DateOnly(Model.From.Year, BabySitting.Services.Scheduling.ScheduleMath.LocalDate(Model.Now).Month, 1).ToString("MMMM yyyy"))</h2></div><strong>@DashboardViewModel.Money(Model.MonthGross, Model.Currency)</strong><small>Recorded payments for @(new DateOnly(Model.From.Year, BabySitting.Services.Scheduling.ScheduleMath.LocalDate(Model.Now).Month, 1).ToString("MMM yyyy"))</small></article><article class="dash-card portal-kpi"><div><span class="round-icon"><svg class="line-icon"><use href="#icon-clock" /></svg></span><h2>Pending payouts</h2></div><strong>@DashboardViewModel.Money(Model.PendingPayouts, Model.Currency)</strong><small>@Model.Payouts.Count(p => p.Currency == Model.Currency && p.Status == PayoutStatus.Requested) recorded requests · all time</small></article><article class="dash-card portal-kpi"><div><span class="round-icon"><svg class="line-icon"><use href="#icon-check" /></svg></span><h2>Paid out</h2></div><strong>@DashboardViewModel.Money(Model.PaidOut, Model.Currency)</strong><small>Recorded paid payouts · all time</small></article></div>
<div class="earnings-chart-row"><partial name="_MonthlyBars" model="Model" /><aside class="dash-card next-payout dark"><h2>@(pending is null ? "Available to request" : "Latest payout request")</h2><strong>@DashboardViewModel.Money(pending?.Amount ?? Model.AvailableBalance, Model.Currency)</strong><p>@(pending is null ? "From completed, paid bookings after existing reservations." : "Requested " + DashboardViewModel.Local(pending.CreatedAtUtc).ToString("ddd d MMM") + " · awaiting processing")</p>
@if (pending is not null) { <div class="payout-booking-lines">@foreach (var group in pending.Allocations.GroupBy(a => a.Payment.BookingId).Take(3)) { <div><span>@group.First().Payment.Booking.Request.Title</span><strong>@DashboardViewModel.Money(group.Sum(a => a.Amount), Model.Currency)</strong></div> }</div><form asp-action="CancelPayout" method="post"><input type="hidden" name="id" value="@pending.Id" /><button class="btn btn-light btn-sm full-width" type="submit">Cancel this request</button></form> }
<a asp-action="Settings" asp-fragment="payout-settings" class="btn btn-lime btn-sm full-width"><svg class="line-icon"><use href="#icon-settings" /></svg>Payout settings</a><small>Payout requests reserve funds locally. Bank transfers are not connected.</small></aside></div>
<section class="dash-card payment-table-card"><div class="card-heading"><h2>Recent payments</h2><span class="subtle-link">@Model.Currency · @Model.From.Year</span></div><div class="portal-table-scroll"><table class="portal-table"><thead><tr><th>Parent / booking</th><th>Service</th><th>Date</th><th>Payment status</th><th class="numeric">Amount</th></tr></thead><tbody>
@foreach (var payment in Model.PeriodPayments.OrderByDescending(p => p.PaidAtUtc ?? p.CreatedAtUtc))
{
    var paidOut = Model.Payouts.Where(p => p.Status == PayoutStatus.Paid).SelectMany(p => p.Allocations).Where(a => a.PaymentId == payment.Id).Sum(a => a.Amount) >= payment.Amount;
    <tr><td><a asp-controller="SitterBookings" asp-action="Details" asp-route-id="@payment.BookingId" class="payment-owner"><span class="pet-emoji">🧸</span><span>@payment.Booking.Customer.FirstName @payment.Booking.Customer.LastName<small>Booking #@SitterBookingsViewModel.Reference(payment.Booking)</small></span></a></td><td>@DashboardViewModel.Service(payment.Booking.Request.ServiceType)</td><td>@DashboardViewModel.Local(payment.PaidAtUtc ?? payment.CreatedAtUtc).ToString("dd MMM yyyy")</td><td><span class="status-chip @(payment.Status == PaymentStatus.Succeeded ? paidOut ? "green" : "lime" : payment.Status == PaymentStatus.Failed ? "red" : "yellow")">@(payment.Status == PaymentStatus.Succeeded ? paidOut ? "Paid out" : "✓ Payment successful" : payment.Status == PaymentStatus.Failed ? "Payment failed" : payment.Status == PaymentStatus.Refunded ? "Refunded" : "Payment pending")</span></td><td class="numeric">@DashboardViewModel.Money(payment.Amount, payment.Currency)</td></tr>
}
@if (!Model.PeriodPayments.Any()) { <tr><td colspan="5"><div class="portal-empty"><span class="round-icon lime"><svg class="line-icon"><use href="#icon-wallet" /></svg></span><h3>No payments in this period</h3><p>Payment records for your bookings will appear here.</p></div></td></tr> }
</tbody></table></div></section>
<dialog class="dashboard-dialog" id="payout-dialog" aria-labelledby="payout-title"><button type="button" class="round-icon dialog-close" data-close aria-label="Close"><svg class="line-icon"><use href="#icon-close" /></svg></button><span class="round-icon lime"><svg class="line-icon"><use href="#icon-wallet" /></svg></span><h2 id="payout-title">Request a payout</h2><p>You have @DashboardViewModel.Money(Model.AvailableBalance, Model.Currency) available from completed, paid bookings. This records a request and reserves the amount. It does not transfer money to a bank.</p><form asp-action="RequestPayout" method="post" class="portal-form"><input type="hidden" name="ClientToken" value="@Model.PayoutToken" /><input type="hidden" name="Currency" value="@Model.Currency" /><label>Amount · @Model.Currency<input type="number" name="Amount" min="0.01" max="@Model.AvailableBalance.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" required value="@Model.AvailableBalance.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></label><button type="submit" class="btn btn-dark btn-sm">Record payout request</button></form></dialog>
@section Scripts { <script src="~/js/baby-account.js" asp-append-version="true"></script> }
