@using BabySitting.ViewModels
@model SitterNotificationsViewModel
<nav class="notification-tabs" aria-label="Notification type" data-notification-tabs>@foreach (var (key, label, category) in new[] { ("all", "All", NotificationCategory.General), ("request", "Requests", NotificationCategory.Request), ("booking", "Bookings", NotificationCategory.Booking), ("payment", "Payments", NotificationCategory.Payment), ("review", "Reviews", NotificationCategory.Review) }) { <a asp-action="Notifications" asp-route-category="@key" asp-route-search="@Model.Search" class="@(Model.Filter == key ? "active" : "")" aria-current="@(Model.Filter == key ? "page" : null)" data-alert-link>@label <span>@(key == "all" ? Model.Items.Count : Model.Items.Count(n => SitterNotificationsViewModel.Category(n) == category))</span></a> }</nav>
