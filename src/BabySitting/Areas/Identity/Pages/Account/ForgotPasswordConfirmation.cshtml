@page
@model BabySitting.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["AuthVariant"] = "auth-recovery-page";
    ViewData["Title"] = "Check your inbox";
}
<section class="auth-form auth-recovery" aria-labelledby="auth-heading">
    <a class="auth-back" asp-page="Login"><svg class="line-icon back-arrow"><use href="#icon-arrow" /></svg>Back to log in</a>
    <span class="recovery-icon" aria-hidden="true"><svg class="line-icon"><use href="#icon-mail" /></svg></span>
    <h1 id="auth-heading">Check your inbox</h1>
    <p class="auth-subtitle">If @(Model.Email ?? "your email address") matches a confirmed, active account, you’ll receive a reset link. It expires in @Model.Expiry.</p>
    <div class="recovery-success" role="status"><svg class="line-icon" aria-hidden="true"><use href="#icon-check" /></svg>Reset link requested</div>
    @if (Model.InboxUrl is not null)
    {
        <a class="auth-submit" href="@Model.InboxUrl" target="_blank" rel="noopener noreferrer"><svg class="line-icon diagonal-arrow"><use href="#icon-arrow" /></svg>Open email app<span class="sr-only"> (opens in a new tab)</span></a>
    }
    else
    {
        <a class="auth-submit" asp-page="Login"><svg class="line-icon"><use href="#icon-arrow" /></svg>Back to log in</a>
    }
    @if (Model.Email is not null)
    {
        <form method="post" asp-page-handler="Resend" class="recovery-resend" data-resend-form data-resend-at="@Model.RetryAt">
            <span>Didn’t get it?</span> <button type="submit" class="resend-button" data-resend-button>Resend email</button>
        </form>
    }
    <a class="recovery-another" asp-page="ForgotPassword">Try another email address</a>
</section>
