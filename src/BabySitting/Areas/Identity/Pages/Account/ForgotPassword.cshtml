@page
@model BabySitting.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["AuthVariant"] = "auth-recovery-page";
    ViewData["Title"] = "Forgot your password";
}
<section class="auth-form auth-recovery" aria-labelledby="auth-heading">
    <a class="auth-back" asp-page="Login"><svg class="line-icon back-arrow"><use href="#icon-arrow" /></svg>Back to log in</a>
    <span class="recovery-icon" aria-hidden="true"><svg class="line-icon"><use href="#icon-lock" /></svg></span>
    <h1 id="auth-heading">Forgot your password?</h1>
    <p class="auth-subtitle">Enter the email linked to your account and we’ll send you a secure reset link.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="auth-errors" role="alert"></div>
        <div class="auth-field"><label asp-for="Input.Email">Email address</label><div class="input-wrap"><svg class="line-icon"><use href="#icon-mail" /></svg><input asp-for="Input.Email" autocomplete="email" placeholder="you@example.com" /></div><span asp-validation-for="Input.Email" class="field-error"></span></div>
        <button type="submit" class="auth-submit"><svg class="line-icon"><use href="#icon-send" /></svg>Send reset link</button>
    </form>
    <p class="auth-switch">Remembered it? <a asp-page="Login">Log in</a></p>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
